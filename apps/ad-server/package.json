{
  "name": "ad-server",
  "version": "0.0.1",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "^7.10.0",
    "@project/ad-renderer": "workspace:*",
    "@project/db": "workspace:*",
    "@project/page-renderer": "workspace:*",
    "fastify": "^5.12.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
