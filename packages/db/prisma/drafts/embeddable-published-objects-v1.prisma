enum EmbedObjectType {
  PAGE
  ADVERTISEMENT
}

enum EmbedDeploymentStatus {
  ACTIVE
  PAUSED
  UNPUBLISHED
}

enum EmbedDomainPolicy {
  ANY
  ALLOWLIST
}

enum EmbedEventType {
  EMBED_LOADED
  PAGE_VIEWED
  FORM_STARTED
  FORM_SUBMITTED
  FORM_SUCCEEDED
  FORM_FAILED
  AD_LOADED
  AD_IMPRESSION
  AD_CLICKED
}

// Add to the existing PublishedPageVersion model:
//   rendererFormatVersion String @default("page-embed-v1")
