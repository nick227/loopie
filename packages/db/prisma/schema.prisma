// ---------- CRM customer graph ----------
//
// Person is Contact. Source systems are Integration + ExternalContactRecord.
// CSV is not an Integration; ImportJob writes ExternalContactRecord with provider CSV.
// Do not reuse PlatformConnection (ad-platform OAuth). Capabilities live on Integration
// and in the provider catalog — consumers must not switch on provider names.

enum CrmProvider {
  HUBSPOT
  SALESFORCE
  SHOPIFY
  WOOCOMMERCE
  WEBHOOK
  SQUARE
  PIPEDRIVE
  CSV
}

enum IntegrationStatus {
  INCOMPLETE
  CONNECTED
  NEEDS_REAUTH
  PAUSED
}

enum SyncDirection {
  INBOUND
}

enum ContactIdentifierKind {
  EMAIL
  PHONE
}

enum ExternalMatchStatus {
  LINKED
  UNMATCHED
  AMBIGUOUS
}

enum ExternalEventType {
  CONTACT_CREATED
  CONTACT_UPDATED
  DEAL_WON
  ORDER_CREATED
  PAYMENT_COMPLETED
  APPOINTMENT_COMPLETED
  CUSTOMER_TAGGED
}

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Integration {
  id                String            @id @default(cuid())
  businessId        String
  provider          CrmProvider
  label             String?
  externalAccountId String?
  status            IntegrationStatus @default(INCOMPLETE)
  syncDirection     SyncDirection     @default(INBOUND)
  lastSyncAt        DateTime?
  lastSyncAttemptAt DateTime?
  lastSyncError     String?           @db.Text
  syncHasMore       Boolean           @default(false)
  syncCursor        String?
  capabilities      Json
  credentialsEnc    String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  business       Business                @relation(fields: [businessId], references: [id])
  identifiers    ContactIdentifier[]
  contactRecords ExternalContactRecord[]
  events         ExternalEvent[]
  importJobs     ImportJob[]

  @@unique([businessId, provider, externalAccountId])
  @@index([businessId, provider])
}

model ImportJob {
  id            String          @id @default(cuid())
  businessId    String
  integrationId String?
  status        ImportJobStatus @default(COMPLETED)
  created       Int             @default(0)
  linked        Int             @default(0)
  ambiguous     Int             @default(0)
  skipped       Int             @default(0)
  // Set only on status FAILED — the sync-job lifecycle must never leave a run stuck looking
  // "in progress" forever with no visible reason it stopped.
  error         String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  business    Business                @relation(fields: [businessId], references: [id])
  integration Integration?            @relation(fields: [integrationId], references: [id])
  records     ExternalContactRecord[]

  @@index([businessId, createdAt])
  @@index([integrationId, createdAt])
}

model ContactIdentifier {
  id              String                @id @default(cuid())
  businessId      String
  contactId       String
  kind            ContactIdentifierKind
  normalizedValue String
  source          String
  integrationId   String?
  isPrimary       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  contact     Contact      @relation(fields: [contactId], references: [id])
  integration Integration? @relation(fields: [integrationId], references: [id])

  @@unique([businessId, kind, normalizedValue])
  @@index([contactId])
}

model ExternalContactRecord {
  id                  String              @id @default(cuid())
  businessId          String
  contactId           String?
  integrationId       String?
  importJobId         String?
  provider            CrmProvider
  externalId          String
  scopeKey            String
  matchStatus         ExternalMatchStatus @default(LINKED)
  candidateContactIds Json?
  externalUpdatedAt   DateTime?
  syncedAt            DateTime?
  raw                 Json?
  sourceSnapshot      Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  integration Integration? @relation(fields: [integrationId], references: [id])
  importJob   ImportJob?   @relation(fields: [importJobId], references: [id])

  @@unique([scopeKey, externalId])
  @@index([businessId, matchStatus])
  @@index([contactId])
}

model ExternalEvent {
  id              String            @id @default(cuid())
  businessId      String
  integrationId   String?
  contactId       String?
  saleId          String?
  provider        CrmProvider
  type            ExternalEventType
  externalEventId String
  scopeKey        String
  occurredAt      DateTime
  payload         Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  integration Integration? @relation(fields: [integrationId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  sale        Sale?        @relation(fields: [saleId], references: [id])

  @@unique([scopeKey, externalEventId])
  @@index([businessId, type])
  @@index([contactId])
}

model LoopieSession {
  id                String   @id
  businessId        String
  firstAdRunId      String?
  firstDeploymentId String?
  firstSourceType   String?
  platformClickIds  Json?
  utms              Json?
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, lastSeenAt])
}

// ---------- Rate limiting ----------

// A shared, DB-backed fixed-window counter for public-endpoint rate limiting — used by both
// apps/server and apps/ad-server (see lib/rateLimit.ts in this package), which is why it lives
// here rather than in either app: a process-local in-memory Map only limits traffic reaching that
// one process, so it silently stops working the moment there's more than one instance (Railway
// horizontal scaling) or after any restart. `key` already encodes the window boundary (see
// consumeRateLimit), so a plain upsert is race-free without needing row locks or raw SQL.
// `expiresAt` is one full window past the bucket's own window, kept for the periodic cleanup
// sweep to know when it's safe to delete.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

// ---------- Activity Command Center ----------

enum ActivitySourceKind {
  LOOPIE
  PLATFORM
  WEBSITE
  CHANNEL
  USER
  AUTOMATION
}

enum ActivityAttentionState {
  INFORMATION
  ACTION_REQUIRED
  FAILURE
}

model ActivityItem {
  id         String @id @default(cuid())
  businessId String

  // Stable source identity for idempotency
  sourceKind       ActivitySourceKind
  sourceRecordType String
  sourceRecordId   String
  eventKey         String

  taxonomyVersion String
  type            String

  occurredAt  DateTime
  observedAt  DateTime
  projectedAt DateTime @default(now())

  storyId String

  // Denormalized source info for querying
  sourceLabel     String
  sourceAccountId String?

  // Actor info
  actorKind  String // CONTACT, USER, SYSTEM, AUTOMATION
  actorId    String?
  actorLabel String

  status    String?
  attention ActivityAttentionState
  summary   String
  detail    String?                @db.Text

  // Explicit canonical references
  personId    String?
  leadId      String?
  adId        String?
  runId       String?
  pageId      String?
  formId      String?
  messageId   String?
  broadcastId String?
  saleId      String?

  // Polymorphic extras
  aggregation Json?
  actions     Json?

  attentionItem AttentionItem?

  // Constraint for idempotency: The same canonical event projects into the same Activity item
  @@unique([businessId, sourceKind, sourceRecordType, sourceRecordId, eventKey])
  // Expected query shape indexes
  @@index([businessId, occurredAt])
  @@index([businessId, type])
  @@index([businessId, sourceKind])
  @@index([businessId, attention])
  // High-value reference lookups
  @@index([businessId, personId])
  @@index([businessId, runId])
  @@index([businessId, messageId])
}

model ActivityProjectionFailure {
  id               String    @id @default(cuid())
  businessId       String
  sourceRecordType String
  sourceRecordId   String
  error            String    @db.Text
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([businessId, resolvedAt])
}

enum AttentionItemState {
  NEEDS_ACTION
  IN_PROGRESS
  SNOOZED
  RESOLVED
}

model AttentionItem {
  id           String             @id @default(cuid())
  activityId   String             @unique
  state        AttentionItemState @default(NEEDS_ACTION)
  assigneeId   String?
  priority     String?
  dueAt        DateTime?
  snoozedUntil DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  activityItem ActivityItem @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model ActivitySeenState {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  seenAt     DateTime

  @@unique([userId, businessId])
}

// A named, reusable preset of Activity stream filter query params (source/type/needsAction/...) —
// see ActivityFilters.tsx's "Save View" action and ActivitySidebar.tsx's list. Filters is a plain
// string-keyed bag mirroring the same query params /activity itself accepts, not a typed schema
// of its own, since the stream's own filterable fields are already the source of truth. Scoped to
// the individual user, not just the business — each user's own saved views, matching
// ActivitySavedViewService's businessId+userId scoping.
model ActivitySavedView {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  name       String
  filters    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, userId])
}

enum AdClickBehavior {
  NONE
  URL
  HOST
}

model PublishedAdvertisementVersion {
  id               String            @id @default(cuid())
  advertisementId  String
  version          Int
  creativeSnapshot Json
  assetIds         Json
  clickBehavior    AdClickBehavior   @default(HOST)
  destinationUrl   String?
  dimensions       String? // e.g. "300x250"
  accessibleLabel  String?
  // Ad Designer (2026-09-03) — folded onto the top level for cheap querying/branching, mirroring
  // `dimensions` above; the full design (textPlacement/fontScale/etc) lives inside
  // `creativeSnapshot` (see AdvertisementService.publish), same "one canonical hashed payload"
  // discipline the rest of this model already follows. Null for pre-existing generic ads.
  format           AdCreativeFormat?
  formatVersion    String            @default("1.0")
  checksum         String?
  publishedAt      DateTime          @default(now())
  publishedBy      String?
  archivedAt       DateTime?

  advertisement          Advertisement     @relation(fields: [advertisementId], references: [id])
  activeEmbedDeployments EmbedDeployment[]
  riverPosts             RiverPost[]

  @@unique([advertisementId, version])
  @@index([advertisementId])
}

// ---------- River (native B2B social feed, see apps/web/public/river-b2b-social-proposal) ----------
//
// River is deliberately NOT a general SocialPost/SocialDistribution/SocialPublisher abstraction —
// with exactly one provider (River itself) that generic interface would be premature. This is the
// literal, single-provider model; the adapter abstraction is the right call to introduce once a
// second real provider (e.g. LinkedIn) exists to inform its shape, not before.
enum RiverPostType {
  TEXT
  AD
  // Slice 6 — shares an existing LandingPage, same frozen-snapshot discipline as AD below.
  PAGE
}

model RiverPost {
  id                              String        @id @default(cuid())
  businessId                      String
  type                            RiverPostType
  body                            String        @db.Text
  // Set only for type=AD. publishedAdvertisementVersionId is pinned at creation and never
  // updated — a RiverPost renders from this immutable snapshot forever, the same
  // freeze-at-publish discipline as PublishedPageVersion.formSnapshot. Editing the Advertisement
  // draft or publishing a newer version afterward never changes an already-created post.
  advertisementId                 String?
  publishedAdvertisementVersionId String?
  // Set only for type=PAGE — mirrors the AD fields above exactly (frozen at share time).
  landingPageId                   String?
  publishedPageVersionId          String?
  // Slice 6 — universal optional composer fields, any type. imageAssetIds/videoAssetId are
  // TEXT-only at the service layer (a share's visual comes from the shared object itself — see
  // the slice-6 plan doc's confirmed "share = source object's own visual" rule); link/CTA are
  // available regardless of type. Link preview fields are fetched once at creation and frozen,
  // same discipline as everything else here — a link's target page can change or disappear later
  // without silently altering an already-published post.
  imageAssetIds                   Json?
  videoAssetId                    String?
  linkUrl                         String?
  linkPreviewTitle                String?
  linkPreviewDescription          String?       @db.Text
  linkPreviewImageUrl             String?
  ctaLabel                        String?
  ctaUrl                          String?
  createdAt                       DateTime      @default(now())
  deletedAt                       DateTime?

  business                      Business                       @relation(fields: [businessId], references: [id])
  advertisement                 Advertisement?                 @relation(fields: [advertisementId], references: [id])
  publishedAdvertisementVersion PublishedAdvertisementVersion? @relation(fields: [publishedAdvertisementVersionId], references: [id])
  landingPage                   LandingPage?                   @relation(fields: [landingPageId], references: [id])
  publishedPageVersion          PublishedPageVersion?          @relation(fields: [publishedPageVersionId], references: [id])
  engagementEvents              RiverEngagementEvent[]
  reactions                     RiverReaction[]
  comments                      RiverComment[]
  // Back-reference only, for the named relation on Business.pinnedRiverPost above —
  // pinnedRiverPostId's @unique makes this a real one-to-one at the DB level (a post can be
  // pinned by at most one Business row), though the actual "only your own post" rule is an
  // app-level check in RiverPostService#pin, not something a unique index alone expresses.
  pinnedByBusiness              Business?                      @relation("BusinessPinnedRiverPost")

  @@index([businessId, createdAt])
  @@index([deletedAt, createdAt])
}

// Day-one engagement events only: IMPRESSION/CLICK/PROFILE_VISIT. REACTION/FOLLOW/COMMENT/SHARE
// are explicitly deferred (see the River plan doc). Mirrors PageView's simplicity deliberately —
// a plain row-per-event table, no idempotency key, no outbox — not EmbedEvent's heavier
// idempotent-outbox machinery, which exists to solve cross-origin embed problems River doesn't
// have. actorBusinessId stays null in this slice: no route in this codebase does optional-auth
// detection on a public (security: []) route, and River's public GET routes are no exception.
enum RiverEngagementEventType {
  IMPRESSION
  CLICK
  PROFILE_VISIT
}

model RiverEngagementEvent {
  id              String                   @id @default(cuid())
  riverPostId     String
  type            RiverEngagementEventType
  sessionId       String?
  actorBusinessId String?
  occurredAt      DateTime                 @default(now())

  riverPost RiverPost @relation(fields: [riverPostId], references: [id])

  @@index([riverPostId, type])
}

// Slice 2: the two "later" items from slice 1's own doc comment (see RiverEngagementEventType
// above) — the first River features that need to know *who* is acting. A reaction's row is the
// reaction; there is no separate event-log entry for it (would just duplicate the same fact — see
// the River slice-2 plan doc's "not a big abstraction" scope call). Count = COUNT(*).
model RiverReaction {
  id              String   @id @default(cuid())
  riverPostId     String
  actorBusinessId String
  createdAt       DateTime @default(now())

  riverPost RiverPost @relation(fields: [riverPostId], references: [id])
  actor     Business  @relation("RiverReactionActor", fields: [actorBusinessId], references: [id])

  @@unique([riverPostId, actorBusinessId])
  @@index([riverPostId])
}

// A plain directed edge between businesses, not tied to any post. Self-follow is rejected at the
// service layer (no DB constraint cleanly expresses "not equal to the other FK on this row" — same
// reasoning as AttributionEvent's deploymentId/adUnitId XOR being app-level, not DB-level).
model RiverFollow {
  id                 String   @id @default(cuid())
  followerBusinessId String
  followedBusinessId String
  createdAt          DateTime @default(now())

  follower Business @relation("RiverFollowFollower", fields: [followerBusinessId], references: [id])
  followed Business @relation("RiverFollowFollowed", fields: [followedBusinessId], references: [id])

  @@unique([followerBusinessId, followedBusinessId])
  @@index([followedBusinessId])
}

// River comments (see the "River comments" plan doc). One level of nesting only — a reply's
// parentCommentId points at a top-level comment; RiverCommentService#create rejects a reply-to-a-
// reply at the app level (checked against the parent's own parentCommentId being null), the same
// way self-follow and the AD/PAGE XOR above are app-level checks rather than DB constraints. Same
// soft-delete convention as RiverPost (deletedAt, no hard delete — replies point at this row's
// id, so a hard delete would orphan them).
model RiverComment {
  id              String    @id @default(cuid())
  riverPostId     String
  actorBusinessId String
  body            String    @db.Text
  parentCommentId String?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  riverPost RiverPost      @relation(fields: [riverPostId], references: [id])
  actor     Business       @relation("RiverCommentActor", fields: [actorBusinessId], references: [id])
  parent    RiverComment?  @relation("RiverCommentReplies", fields: [parentCommentId], references: [id])
  replies   RiverComment[] @relation("RiverCommentReplies")

  @@index([riverPostId, parentCommentId, createdAt])
}

enum EmbedDeploymentStatus {
  ACTIVE
  PAUSED
  UNPUBLISHED
}

enum DomainPolicy {
  ANY
  ALLOWLIST
}

enum EmbedObjectType {
  PAGE
  ADVERTISEMENT
}

model EmbedDeployment {
  id                           String                @id @default(cuid())
  publicId                     String                @unique // 'pg_...' or 'ad_...'
  objectType                   EmbedObjectType
  landingPageId                String?
  advertisementId              String?
  activePageVersionId          String?
  activeAdvertisementVersionId String?
  status                       EmbedDeploymentStatus @default(ACTIVE)
  domainPolicy                 DomainPolicy          @default(ANY)
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt

  landingPage                LandingPage?                   @relation(fields: [landingPageId], references: [id])
  advertisement              Advertisement?                 @relation(fields: [advertisementId], references: [id])
  activePageVersion          PublishedPageVersion?          @relation(fields: [activePageVersionId], references: [id])
  activeAdvertisementVersion PublishedAdvertisementVersion? @relation(fields: [activeAdvertisementVersionId], references: [id])
  allowedOrigins             EmbedAllowedOrigin[]
  instances                  EmbedInstance[]
  events                     EmbedEvent[]

  @@index([landingPageId])
  @@index([advertisementId])
}

model EmbedAllowedOrigin {
  id                String   @id @default(cuid())
  embedDeploymentId String
  normalizedOrigin  String
  createdAt         DateTime @default(now())

  embedDeployment EmbedDeployment @relation(fields: [embedDeploymentId], references: [id])

  @@unique([embedDeploymentId, normalizedOrigin])
  @@index([embedDeploymentId])
}

model EmbedInstance {
  id                   String          @id @default(cuid())
  objectType           EmbedObjectType
  objectId             String
  embedDeploymentId    String
  versionId            String
  snapshotChecksum     String
  authorizedOrigin     String
  attributionSessionId String?
  createdAt            DateTime        @default(now())

  embedDeployment EmbedDeployment @relation(fields: [embedDeploymentId], references: [id])
  events          EmbedEvent[]

  @@index([embedDeploymentId])
  @@index([attributionSessionId])
}

model EmbedEvent {
  id                   String          @id @default(cuid())
  idempotencyKey       String          @unique
  eventType            String
  protocolVersion      String?
  objectType           EmbedObjectType
  objectId             String
  embedDeploymentId    String
  versionId            String
  embedInstanceId      String
  snapshotChecksum     String
  authorizedOrigin     String
  hostUrl              String?         @db.Text
  referrer             String?         @db.Text
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  attributionSessionId String?
  upstreamClickId      String?
  occurredAt           DateTime

  embedDeployment EmbedDeployment        @relation(fields: [embedDeploymentId], references: [id])
  embedInstance   EmbedInstance          @relation(fields: [embedInstanceId], references: [id])
  outbox          EmbedProjectionOutbox?

  @@index([embedDeploymentId])
  @@index([embedInstanceId])
}

model EmbedBootstrapNonce {
  nonce        String   @id
  deploymentId String
  origin       String
  expiresAt    DateTime
}

enum EmbedProjectionStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

model EmbedProjectionOutbox {
  id               String                @id @default(cuid())
  businessId       String
  embedEventId     String?               @unique
  formSubmissionId String?               @unique
  idempotencyKey   String                @unique
  status           EmbedProjectionStatus @default(PENDING)
  retryCount       Int                   @default(0)
  nextAttemptAt    DateTime?
  error            String?               @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  embedEvent     EmbedEvent?     @relation(fields: [embedEventId], references: [id])
  formSubmission FormSubmission? @relation(fields: [formSubmissionId], references: [id])

  @@index([businessId, status, nextAttemptAt])
}

// ---------- Calendar (goal-driven scheduling) ----------
//
// Product spirit: goal-driven business coaching, not project management. The lifecycle is
// Idea -> Schedule -> Today/This Week -> Done. Two models carry that: GoalIdeaTemplate is
// reusable suggestion *content* (system-authored, a future business-type pack, or a business's
// own quickly-typed idea) — never hard-coded in the frontend, same "content model, not UI"
// discipline as LandingPageTemplate. ScheduledGoal is the one concrete unit of work Calendar
// owns once an idea is scheduled (or created directly, e.g. from a CRM "next action"). Calendar
// owns intention/scheduling/estimated-effort/completion only — subjectType/subjectId is an
// optional loose pointer at the object another feature already owns (Lead, LandingPage,
// Advertisement, RiverPost); Calendar never copies that feature's own data in.
enum GoalSubjectType {
  GENERAL
  CRM
  ADVERTISEMENT
  PAGE
  RIVER
  BUSINESS
}

// The one universal progression Loopie coaches every business through (2026-09-02 "Calendar as
// business coach" pass) — Foundation (get the basics live) -> Attract (put yourself out there) ->
// Capture (turn attention into leads) -> Convert (turn leads into customers) -> Grow (compound
// it). A single fixed ladder for V1, not a business-configurable Playbook table: there is exactly
// one playbook (indie web developers/studios/service businesses), so its order lives here as an
// enum rather than as rows nobody edits. GoalIdeaTemplate.stage assigns each idea a rung; the
// board's `currentStage` is computed (not stored) from which stage's ideas are still actionable —
// see CalendarService.
enum CoachStage {
  FOUNDATION
  ATTRACT
  CAPTURE
  CONVERT
  GROW
}

// The classification from the product spec (action/outcome/maintenance/...) — deliberately
// invisible in the initial UI, kept only so future surfacing (grouping, tone, iconography) has
// something to key off without another migration.
enum GoalIdeaType {
  ACTION
  OUTCOME
  MAINTENANCE
  CREATION
  RELATIONSHIP
  EXPERIMENT
  REVIEW
}

// MANUAL: the user marks it done themselves (the POC default for almost everything). ENTITY_STATE
// and COUNT are the architecture for automatic completion/progress — a real event elsewhere in
// the product (a page publish, a logged CRM interaction) can close or advance the goal. Wired for
// a first real vertical slice each (see CalendarService's completeByMetric); everything else stays
// MANUAL until a given metric is worth automating.
enum GoalTrackingType {
  MANUAL
  ENTITY_STATE
  COUNT
}

enum ScheduledGoalStatus {
  SCHEDULED
  DONE
  DISMISSED
}

// How this ScheduledGoal came to exist — analytics/debugging only, no branching logic reads it
// beyond CRM_NEXT_ACTION (whose rows are identified by externalKey, not this field). WORKFLOW is
// reserved for the not-yet-built sales-workflow engine described in the product spec, so a future
// workflow step creating Calendar work is additive, not a schema change. ASSISTANT_PLAYBOOK
// (2026-09-04) is a distinct source from WORKFLOW on purpose — a Playbook is a deterministic,
// goal-cycle-scoped batch of steps scheduled once from the Assistant, not the reserved recurring
// lead-event engine WORKFLOW is parked for.
enum ScheduledGoalSource {
  IDEA_TEMPLATE
  USER_CREATED
  CRM_NEXT_ACTION
  WORKFLOW
  ASSISTANT_PLAYBOOK
}

// The Assistant's goal-cycle phase (2026-09-04 "Assistant becomes the consultant" pass) —
// Learn -> Act -> Review -> Grow -> Act ... See business-guidance/phaseEngine.ts for the
// deterministic transition rules; this enum is just the state.
enum AssistantPhase {
  LEARN
  ACT
  REVIEW
  GROW
}

// Deterministic Review classification — see business-guidance/signals/reviewSignals.ts and
// AssistantSignalService. Never inferred by AI; always derived from real Loopie data or an
// explicit user answer to a question Loopie can't derive.
enum AssistantReviewOutcome {
  WORKING
  PARTIALLY_WORKING
  NOT_WORKING
  NOT_ENOUGH_DATA
  NOT_EXECUTED
}

enum AssistantGoalCycleStatus {
  ACTIVE
  COMPLETED
}

enum GoalEventType {
  CREATED
  SCHEDULED
  RESCHEDULED
  COMPLETED
  DISMISSED
  REMINDER_SENT
  PROGRESS_UPDATED
}

model GoalIdeaTemplate {
  id                     String           @id @default(cuid())
  // Null = system-authored, offered to every business (subject to businessTypes targeting below).
  // Set = a business's own quickly-typed idea ("+ Add idea") — same model, same idea-pool/
  // schedule/dismiss plumbing, just not reusable across tenants. Mirrors
  // LandingPageTemplate.businessId's nullable-means-system convention.
  businessId             String?
  isSystem               Boolean          @default(true)
  title                  String
  // The "why this matters" copy shown in the detail view — never surfaced in the compact row,
  // matching the minimal-UI mandate; only shown once someone taps in for more.
  detail                 String?          @db.Text
  ideaType               GoalIdeaType     @default(ACTION)
  subjectType            GoalSubjectType  @default(GENERAL)
  stage                  CoachStage       @default(FOUNDATION)
  // Template ids (this business's own ScheduledGoal history) that must have a DONE goal before
  // this idea is offered — the deterministic "completing work unlocks the next useful
  // suggestion" mechanism. Most ideas have none (universal, always on offer, like "Ask 3
  // customers for reviews"); a handful of Attract/Capture ideas require the Foundation homepage
  // first. Evaluated in lib/coachRules.ts, not a stage-order blanket lock — `stage` is display/
  // narrative grouping, this field is the actual gate.
  requiresTemplateIds    Json?
  // The reserve-library recurrence rule (2026-09-02 "never run out of ideas" pass): only meaningful
  // for a *static* template (metricKey null) — a dynamic template's own live condition is already
  // its natural recurrence rule, so this is never consulted for one. false (the default) means
  // "one-time" — once a DONE ScheduledGoal exists from this template, it never resurfaces. true
  // means it can come back `cooldownDays` after its most recent completion (e.g. "ask for
  // reviews" every 30 days) — see lib/coachRules.ts's cooldown gate in listIdeas.
  repeatable             Boolean          @default(false)
  cooldownDays           Int?
  // Calendar as command center, not just a list: an idea can carry a real destination inside
  // Loopie so acting on it is one click, not a hunt through nav. NAVIGATE is the only type this
  // pass implements (a plain in-app path); OPEN_MODAL/START_FLOW are declared now so a future
  // in-place action (open a modal, kick off a guided flow) is additive, not a schema change. A
  // handful of templates resolve this live instead of from this static field — see
  // lib/coachRules.ts's resolveAction (e.g. "finish your ad draft" points at whichever draft
  // Advertisement actually exists, not a fixed path).
  actionType             String?
  actionTarget           String?
  // Human label for the action button (e.g. "Open profile", "Import contacts") — kept separate
  // from actionTarget so the frontend never has to derive button copy from a URL path.
  actionLabel            String?
  // Freeform string[] of industry keywords (e.g. ["auto", "detailing"]), loosely matched
  // case-insensitively against Business.industry — that field is itself freeform (see its own
  // schema comment), so a controlled vocabulary here would be enforcing a taxonomy that doesn't
  // exist yet. Null/empty = universal, offered to every business regardless of industry.
  businessTypes          Json?
  defaultHorizon         String? // "TODAY" | "THIS_WEEK" | "NEXT_WEEK" — only ever prefills the schedule popover, never persisted as-is on the resulting ScheduledGoal (see that model's own comment on why horizon isn't stored)
  defaultEstimateMinutes Int?
  trackingType           GoalTrackingType @default(MANUAL)
  // Interpreted by CalendarService's fixed switch (e.g. "PAGE_PUBLISHED", "QUALIFIED_LEAD_FOLLOWUPS")
  // — a plain string catalog key, not a formula language, matching this schema's existing
  // discipline of small interpreted-string fields (Interaction.metadata, AutomationLog outcome).
  metricKey              String?
  targetValue            Int?
  priorityWeight         Int              @default(0)
  // Freeform, e.g. "Q4", "SPRING" — advisory only; nothing enforces or filters on it yet, kept so
  // a future seasonal-campaign publishing pass can populate it without a migration.
  seasonality            String?
  // Bumped when a system template's copy/behavior changes materially, so ensureSystemGoalIdeaTemplates
  // can tell "content updated" apart from "business edited their own idea" — mirrors
  // LandingPageTemplate.formatVersion's role.
  contentVersion         Int              @default(1)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  business Business?       @relation(fields: [businessId], references: [id])
  states   GoalIdeaState[]
  goals    ScheduledGoal[]

  @@index([businessId])
}

// Per-business memory of a template's disposition — kept separate from the ScheduledGoal a user
// eventually creates from it (per the product spec: "keep template identity separate from the
// user's resulting scheduled task"), so re-dismissing after completing a recurring idea again
// ("Ask 3 customers for reviews") is a fresh decision, not blocked by history.
model GoalIdeaState {
  id          String    @id @default(cuid())
  businessId  String
  templateId  String
  dismissedAt DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business         @relation(fields: [businessId], references: [id])
  template GoalIdeaTemplate @relation(fields: [templateId], references: [id])

  @@unique([businessId, templateId])
}

model ScheduledGoal {
  id                   String              @id @default(cuid())
  businessId           String
  title                String
  // Copied from the source template's `detail` at creation time (or set directly for
  // USER_CREATED/CRM_NEXT_ACTION goals that have none) — read-only in the detail view; editing an
  // in-flight goal's own notes is out of POC scope.
  detail               String?             @db.Text
  // Frozen at schedule/creation time from whichever destination was resolved then (a template's
  // static actionTarget, a live-resolved one such as a specific draft ad, or set directly for
  // CRM_NEXT_ACTION mirrors — see lib/coachRules.ts's resolveAction and LeadService). Not
  // recomputed on read the way currentValue is; if the underlying record is later deleted the
  // link simply 404s, same as any other stale deep link elsewhere in the app.
  actionType           String?
  actionTarget         String?
  actionLabel          String?
  source               ScheduledGoalSource
  sourceTemplateId     String?
  // Set only for source=ASSISTANT_PLAYBOOK — links this step back to the Assistant goal cycle that
  // scheduled it, so Review can query "how many of this cycle's steps are DONE" directly instead
  // of parsing externalKey strings. Null for every other source.
  assistantGoalCycleId String?
  // Idempotency key for system-mirrored goals only, e.g. "crm-next-action:<leadId>" — lets
  // LeadService upsert the Calendar-visible mirror of Lead.nextActionAt without a lookup race, the
  // same nullable-unique-with-MySQL-null-distinctness trick already used on Sale.idempotencyKey
  // and InboxThread's compound uniques. Rows created any other way leave this null.
  externalKey          String?
  subjectType          GoalSubjectType     @default(GENERAL)
  subjectId            String?
  trackingType         GoalTrackingType    @default(MANUAL)
  metricKey            String?
  targetValue          Int?
  // Only meaningful (and hand-updated) for trackingType=MANUAL; ENTITY_STATE/COUNT progress is
  // always computed live from real data at read time (see CalendarService), never trusted from a
  // stored column that could drift.
  currentValue         Int?
  estimateMinutes      Int?
  // Deliberately no stored `horizon` enum: "Today"/"This week"/"Next week" are resolved to a
  // concrete scheduledFor at schedule time and re-bucketed against `now` on every read, so an item
  // scheduled for "next week" correctly slides into "this week" as the calendar actually turns
  // over — a static label would need its own rollover job to do the same thing correctly.
  scheduledFor         DateTime?
  // Whether scheduledFor carries a meaningful time-of-day (true) or is just a bucket day at local
  // midnight (false, the quick-schedule default). Deliberately not a formatted "HH:mm" string:
  // the frontend renders the time itself from scheduledFor using the viewer's own timezone
  // (Date.toLocaleTimeString), which a server-baked string could never localize correctly for
  // every viewer. Only hasTime=true goals get a time-precise reminder from the poller — see
  // CalendarReminderService.
  hasTime              Boolean             @default(false)
  completedAt          DateTime?
  dismissedAt          DateTime?
  status               ScheduledGoalStatus @default(SCHEDULED)
  // Set once the due-time reminder has fired so the poller never sends it twice.
  reminderSentAt       DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  business           Business            @relation(fields: [businessId], references: [id])
  template           GoalIdeaTemplate?   @relation(fields: [sourceTemplateId], references: [id])
  assistantGoalCycle AssistantGoalCycle? @relation(fields: [assistantGoalCycleId], references: [id])
  events             GoalEvent[]

  @@unique([businessId, externalKey])
  @@index([businessId, status, scheduledFor])
  @@index([subjectType, subjectId])
  @@index([sourceTemplateId])
  @@index([assistantGoalCycleId])
}

// Append-only audit trail for a ScheduledGoal — mirrors AutomationLog's role for Automation.
model GoalEvent {
  id         String        @id @default(cuid())
  goalId     String
  type       GoalEventType
  occurredAt DateTime      @default(now())
  metadata   Json?

  goal ScheduledGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, occurredAt])
}

// Assistant business-consultant pass (2026-09-04) — one Learn->Act->Review->Grow goal cycle. At
// most one ACTIVE cycle per business in practice (queried via findFirst({businessId,
// status:'ACTIVE'}), not enforced by a DB constraint since MySQL has no native partial-unique
// index); COMPLETED cycles are kept so Grow's "this approach produced a sale, do more of it" can
// look back at what actually worked. Deliberately separate from Business.knowledge: knowledge is
// durable facts about the business that outlive any single cycle, this is the ephemeral state of
// one goal-directed pass through Learn/Act/Review/Grow.
model AssistantGoalCycle {
  id                    String                   @id @default(cuid())
  businessId            String
  // GoalKey from business-guidance/goals/goals.ts, e.g. "GET_MORE_CUSTOMERS" — a plain string
  // catalog key, same discipline as GoalIdeaTemplate.metricKey, not an enum (goal content can grow
  // without a migration).
  goal                  String
  // Key of the selected business-guidance/playbooks/*.ts entry, set once Learn resolves one.
  playbookKey           String?
  phase                 AssistantPhase           @default(LEARN)
  reviewOutcome         AssistantReviewOutcome?
  status                AssistantGoalCycleStatus @default(ACTIVE)
  // Reactive-signal dedup (POC scope) — the last signal key shown and when it was dismissed, so
  // the same "3 interested leads need follow-up" nudge doesn't reappear immediately after the user
  // acts on it.
  lastSignalKey         String?
  lastSignalDismissedAt DateTime?
  startedAt             DateTime                 @default(now())
  // Set when schedulePlan first runs (phase -> ACT) — Review's elapsed-time/signal windows measure
  // from here, not from startedAt, so time spent answering Learn questions never counts against
  // the playbook's own review window.
  actStartedAt          DateTime?
  reviewedAt            DateTime?
  completedAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  business Business        @relation(fields: [businessId], references: [id])
  goals    ScheduledGoal[]

  @@index([businessId, status])
}
