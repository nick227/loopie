// Mirrors docs/architecture/00-unified-data-model.md. Source is represented as a discriminant
// (sourceType) plus typed nullable FKs (sourceMessageId / sourceDeploymentId / sourceAdUnitId)
// rather than a true polymorphic relation, so referential integrity is preserved
// on both sides while Lead/Sale/Interaction still read as "one pointer, several origins."
//
// Acquisition chain (2026-08-26 extension): Campaign -> Creative -> external Deployment
// OR first-party AdUnit -> LandingPage -> Form -> FormSubmission -> Contact -> Lead.
// AdUnit is deliberately a separate model from Deployment (see AdUnit section) — first-party
// serving lives in apps/ad-server, a standalone deployable service that shares this schema.
//
// Media/Advertisement/AdRun migration (2026-08-27, in progress — see CLAUDE.md's "Media/
// Advertisement/AdRun Migration Audit"): Campaign/Creative/Deployment are being superseded by
// Advertisement/AdRun (optionally grouped under a Campaign via CampaignAdRun). Permanent policy,
// not just for this migration: a model or column marked `@deprecated` here means the write path
// stops using it going forward — it NEVER means delete it, drop it, or stop reading it. Every
// attribution/finance table that references a deprecated column (campaignId, deploymentId,
// sourceDeploymentId, sourceAdUnitId, ...) keeps that column, its data, and its read paths
// permanently, even after every write path has fully cut over to the new model. Historical
// attribution and financial history must stay queryable forever — a "cleanup" migration that
// drops a deprecated column is a bug, not a completion of this migration.

generator client {
  provider      = "prisma-client-js"
  // "native" alone let Prisma's generate-time OpenSSL probe silently mis-detect on the
  // node:20-alpine images used by every Dockerfile in this repo — it defaulted to
  // "openssl-1.1.x" and generated an engine binary that then failed to load at runtime
  // ("Error loading shared library libssl.so.1.1: No such file or directory"), because recent
  // Alpine actually ships OpenSSL 3.x. Found live against a real Railway deploy, not by
  // inspection. Pinning the musl-openssl-3.0.x target explicitly avoids relying on that probe.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Auth / Tenant ----------

model Business {
  id                   String   @id @default(cuid())
  name                 String
  // Identity fields (2026-08-29) — see docs/strategy/03-product-principles.md's "First-Login
  // Experience" step 0. Freeform strings, not enums: no spec exists yet for a controlled
  // industry/audience vocabulary, and forcing one here would block real onboarding on a
  // classification problem nobody's solved. socialProfiles is a JSON array of
  // { platform, url } rather than a new table — there's no need to query/join on it.
  location            String?
  industry             String?
  targetAudience       String?
  socialProfiles       Json?
  logoUrl              String?
  // Stamped the first time the business identity is saved (setup or a later edit) — not set at
  // registration, since only `name` exists then. Nullable, not a boolean: distinguishes "never
  // completed" from a real timestamp worth keeping.
  identityCompletedAt  DateTime?
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users               User[]
  contacts            Contact[]
  audiences           Audience[]
  assets              Asset[]
  templates           Template[]
  creatives           Creative[]
  messages            Message[]
  automations         Automation[]
  campaigns           Campaign[]
  advertisements      Advertisement[]
  mediaOrderRevisions MediaOrderRevision[]
  inboxThreads        InboxThread[]
  leads               Lead[]
  sales               Sale[]
  interactions        Interaction[]

  landingPageTemplates LandingPageTemplate[]
  landingPages         LandingPage[]
  forms                Form[]
  formSubmissions      FormSubmission[]
  adUnits              AdUnit[]
  affiliates           Affiliate[]
  affiliateClasses     AffiliateClass[]
  affiliateDeals       AffiliateDeal[]

  financialAccounts    FinancialAccount[]
  ledgerTransactions   LedgerTransaction[]
  ledgerEntries        LedgerEntry[]
  payments             Payment[]
  refunds              Refund[]
  budgetAuthorizations BudgetAuthorization[]
  adSpends             AdSpend[]
  commissions          Commission[]
  payouts              Payout[]
  reconciliations      Reconciliation[]
  platformConnections  PlatformConnection[]

  integrations           Integration[]
  importJobs             ImportJob[]
  contactIdentifiers     ContactIdentifier[]
  externalContactRecords ExternalContactRecord[]
  externalEvents         ExternalEvent[]
  loopieSessions         LoopieSession[]

}

enum UserRole {
  USER
  ADMIN
  AFFILIATE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  businessId   String
  role         UserRole  @default(USER)
  isVerified   Boolean   @default(false)
  suspendedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  business          Business            @relation(fields: [businessId], references: [id])
  sessions          Session[]
  affiliate         Affiliate?


  @@index([businessId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
}

// ---------- Contact / Audience ----------

model Contact {
  id              String    @id @default(cuid())
  businessId      String
  name            String
  email           String?
  phone           String?
  company         String?
  source          String?
  tags            Json? // string[] — see docs/00-unified-data-model.md Contact.tags
  emailEligible   Boolean   @default(true)
  smsEligible     Boolean   @default(true)
  emailOptOutAt   DateTime?
  smsOptOutAt     DateTime?
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  business            Business                @relation(fields: [businessId], references: [id])
  leads               Lead[]
  sales               Sale[]
  interactions        Interaction[]
  audienceMemberships AudienceMember[]
  formSubmissions     FormSubmission[]
  automationRuns      AutomationRun[]
  identifiers         ContactIdentifier[]
  externalRecords     ExternalContactRecord[]
  externalEvents      ExternalEvent[]
  inboxThreads        InboxThread[]

  @@unique([businessId, email])
  @@unique([businessId, phone])
  @@index([businessId])
  @@index([businessId, email])
  @@index([businessId, createdAt])
}

enum AudienceType {
  PREDEFINED
  SAVED_FILTER
  MANUAL_LIST
  IMPORTED_LIST
}

model Audience {
  id         String       @id @default(cuid())
  businessId String
  name       String
  type       AudienceType
  filter     Json? // free-form filter, used when type = SAVED_FILTER
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  business             Business         @relation(fields: [businessId], references: [id])
  members              AudienceMember[] // used when type = MANUAL_LIST / IMPORTED_LIST
  messages             Message[]
  suggestedByTemplates Template[]

  @@index([businessId])
}

model AudienceMember {
  id         String   @id @default(cuid())
  audienceId String
  contactId  String
  createdAt  DateTime @default(now())

  audience Audience @relation(fields: [audienceId], references: [id])
  contact  Contact  @relation(fields: [contactId], references: [id])

  @@unique([audienceId, contactId])
  @@index([contactId])
}

// ---------- Asset / Template / Creative ----------

enum AssetType {
  IMAGE
  TEXT
  VIDEO
  AUDIO
}

model Asset {
  id          String    @id @default(cuid())
  businessId  String
  type        AssetType
  name        String
  url         String?
  textContent String?   @db.Text
  mimeType    String?
  sizeBytes   Int?
  widthPx     Int?
  heightPx    Int?
  durationMs  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  business       Business             @relation(fields: [businessId], references: [id])
  templates      TemplateMedia[]
  creatives      CreativeAsset[]
  advertisements AdvertisementAsset[]

  @@index([businessId, type])
}

enum MessageChannel {
  EMAIL
  TEXT
  SOCIAL
}

model Template {
  id                    String         @id @default(cuid())
  businessId            String
  name                  String
  channel               MessageChannel
  purpose               String?
  subject               String?
  body                  String         @db.Text
  cta                   String?
  personalizationTokens Json? // string[]
  suggestedAudienceId   String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  business          Business        @relation(fields: [businessId], references: [id])
  suggestedAudience Audience?       @relation(fields: [suggestedAudienceId], references: [id])
  media             TemplateMedia[]
  messages          Message[]

  @@index([businessId, channel])
}

// Explicit join instead of a single mediaAssetId FK, so a template can pull more
// than one shared Asset later without a schema change (matches Creative's join shape).
model TemplateMedia {
  id         String   @id @default(cuid())
  templateId String
  assetId    String
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id])
  asset    Asset    @relation(fields: [assetId], references: [id])

  @@unique([templateId, assetId])
  @@index([assetId])
}

// @deprecated in favor of Advertisement (which merges Creative/Deployment into an independent ad)
model Creative {
  id                String    @id @default(cuid())
  businessId        String
  name              String
  hostedUrl         String?
  version           Int       @default(1)
  previousVersionId String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  business        Business           @relation(fields: [businessId], references: [id])
  previousVersion Creative?          @relation("CreativeVersionChain", fields: [previousVersionId], references: [id])
  nextVersion     Creative?          @relation("CreativeVersionChain")
  assets          CreativeAsset[]
  campaignLinks   CampaignCreative[]
  deployments     Deployment[]
  adUnits         AdUnit[]

  @@index([businessId])
}

model CreativeAsset {
  id         String   @id @default(cuid())
  creativeId String
  assetId    String
  createdAt  DateTime @default(now())

  creative Creative @relation(fields: [creativeId], references: [id])
  asset    Asset    @relation(fields: [assetId], references: [id])

  @@unique([creativeId, assetId])
  @@index([assetId])
}

// ---------- Message ----------

enum MessageStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
}

model Message {
  id           String         @id @default(cuid())
  businessId   String
  channel      MessageChannel
  subject      String?
  body         String         @db.Text
  audienceId   String
  templateId   String?
  automationId String?
  status       MessageStatus  @default(DRAFT)
  scheduledAt  DateTime?
  sentAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  business   Business    @relation(fields: [businessId], references: [id])
  audience   Audience    @relation(fields: [audienceId], references: [id])
  template   Template?   @relation(fields: [templateId], references: [id])
  automation Automation? @relation(fields: [automationId], references: [id])

  leadsSourced Lead[]        @relation("LeadSourceMessage")
  salesSourced Sale[]        @relation("SaleSourceMessage")
  interactions Interaction[] @relation("InteractionSourceMessage")

  @@index([businessId, status])
  @@index([businessId, channel])
}

// ---------- Automation ----------

enum AutomationTrigger {
  MESSAGE_SENT
  CONTACT_REPLIES
  LEAD_CREATED // fires regardless of source_type — see docs/00-unified-data-model.md
  LEAD_STATUS_CHANGED
  SALE_RECORDED
  DATE_REACHED
}

enum AutomationCondition {
  HAS_REPLIED
  HAS_NOT_REPLIED
  LEAD_STILL_OPEN
  LEAD_REACHED_STAGE
  CUSTOMER_STATUS
  CHANNEL_ELIGIBILITY
}

enum AutomationAction {
  SEND_EMAIL
  SEND_TEXT
  CREATE_REMINDER
  CHANGE_LEAD_STATUS
  NOTIFY_USER
  STOP_SEQUENCE
}

model Automation {
  id               String               @id @default(cuid())
  businessId       String
  name             String
  trigger          AutomationTrigger
  waitDays         Int?
  condition        AutomationCondition?
  conditionValue   Json?
  action           AutomationAction
  actionTemplateId String?
  actionValue      Json?
  isActive         Boolean              @default(true)
  pausedAt         DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  business Business        @relation(fields: [businessId], references: [id])
  messages Message[]
  logs     AutomationLog[]
  runs     AutomationRun[]

  @@index([businessId, trigger])
}

enum AutomationOutcome {
  SENT
  SKIPPED
  FAILED
}

model AutomationLog {
  id            String            @id @default(cuid())
  automationId  String
  contactId     String
  action        AutomationAction
  outcome       AutomationOutcome
  reasonSkipped String?
  triggeredAt   DateTime          @default(now())

  automation Automation @relation(fields: [automationId], references: [id])

  @@index([automationId, triggeredAt])
  @@index([contactId])
}

enum AutomationRunStatus {
  PENDING
  EXECUTED
  SKIPPED
  CANCELED
}

// A scheduled evaluation of one Automation for one Contact, created the moment a trigger event
// happens (see apps/server/src/lib/automationScheduling.ts) and picked up by the poller in
// AutomationExecutorService once `runAt` arrives. Internal execution plumbing, not a new
// user-facing surface — AutomationLog stays the one user-visible history.
model AutomationRun {
  id              String              @id @default(cuid())
  automationId    String
  contactId       String
  leadId          String? // trigger context for LEAD_STILL_OPEN/LEAD_REACHED_STAGE/CHANGE_LEAD_STATUS — plain
  // field not a relation, matching this schema's existing no-new-FK-sprawl pattern (sourceMessageId etc.)
  triggerSourceId String // id of the Lead/Interaction/Sale row that caused scheduling — the dedup key
  triggerEventAt  DateTime // when the trigger event actually happened
  runAt           DateTime // triggerEventAt + waitDays (waitDays null/0 => due on next poll)
  status          AutomationRunStatus @default(PENDING)
  createdAt       DateTime            @default(now())

  automation Automation @relation(fields: [automationId], references: [id])
  contact    Contact    @relation(fields: [contactId], references: [id])

  @@unique([automationId, triggerSourceId])
  @@index([status, runAt])
}

// ---------- Campaign / Deployment ----------

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

// LOOPIE = first-party inventory served by apps/ad-server (AdUnit), reported alongside
// external platforms so campaign performance stays one blended view — see AdUnit section.
enum Platform {
  META
  GOOGLE
  TIKTOK
  LOOPIE
}

// @deprecated in favor of independent Advertisements + AdRuns
model Campaign {
  id               String         @id @default(cuid())
  businessId       String
  name             String
  budget           Decimal        @db.Decimal(12, 2)
  startDate        DateTime
  endDate          DateTime?
  destinationUrl   String?
  status           CampaignStatus @default(DRAFT)
  platforms        Json // Platform[] — MySQL has no native array column
  duplicatedFromId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  business             Business              @relation(fields: [businessId], references: [id])
  duplicatedFrom       Campaign?             @relation("CampaignDuplicate", fields: [duplicatedFromId], references: [id])
  duplicates           Campaign[]            @relation("CampaignDuplicate")
  runs                 CampaignAdRun[]
  creativeLinks        CampaignCreative[]
  deployments          Deployment[]
  adUnits              AdUnit[]
  budgetAuthorizations BudgetAuthorization[]
  adSpends             AdSpend[]
  reconciliations      Reconciliation[]
  ledgerEntries        LedgerEntry[]

  @@index([businessId, status])
}

model CampaignCreative {
  id         String   @id @default(cuid())
  campaignId String
  creativeId String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  creative Creative @relation(fields: [creativeId], references: [id])

  @@unique([campaignId, creativeId])
  @@index([creativeId])
}

enum PlatformConnectionStatus {
  INCOMPLETE
  CONNECTED
  NEEDS_REAUTH
}

model PlatformConnection {
  id             String                   @id @default(cuid())
  businessId     String
  platform       Platform
  status         PlatformConnectionStatus @default(INCOMPLETE)
  accessTokenEnc String                   @db.Text
  tokenExpiresAt DateTime?
  externalUserId String?
  adAccountId    String?
  accountName    String?
  currency       String?
  timezone       String?
  pageId         String?
  defaultCountry String                   @default("US")
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, platform])
  @@index([businessId])
}

enum AdStatus {
  ACTIVE
  PAUSED
}

enum AdRunStatus {
  PENDING
  READY
  ACTIVE
  PAUSED
  ENDED
  VALIDATION_FAILED
  PROVISIONING_FAILED
}

// The platform's own delivery state, normalized across connectors — deliberately a distinct axis
// from AdRunStatus (LOOPIE's own order/lifecycle state). A run can be locally PENDING (never
// touched since creation) while genuinely LIVE on the platform if a human activated it in Ads
// Manager directly — these must never be collapsed into one status field.
enum ProviderDeliveryState {
  NOT_SENT
  DRAFT_SENT
  UNDER_REVIEW
  ELIGIBLE
  LIVE
  PAUSED
  LIMITED
  REJECTED
  ENDED
  UNKNOWN
}

enum SyncHealth {
  CURRENT
  DELAYED
  FAILED
  DISCONNECTED
  NEVER_SYNCED
}

model Advertisement {
  id         String   @id @default(cuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business            Business             @relation(fields: [businessId], references: [id])
  assets              AdvertisementAsset[]
  runs                AdRun[]
  mediaOrderRevisions MediaOrderRevision[]
  inboxThreads        InboxThread[]

  @@index([businessId])
}

// Phase 1 (scoped down, see CLAUDE.md's Media Order Confirmation pass): a durable, immutable,
// numbered record of exactly what was authorized for one (Advertisement, platform, placement)
// destination — the thing this replaces was AdRun.orderSnapshot, a loose untyped JSON blob with
// no numbering, no content hash, and no independent addressability. Deliberately NOT the full
// proposal's MediaOrder/Approval state machine — no approval workflow or permissions exist yet,
// so there is nothing for a header row with a state machine to actually track; a plain revision
// row already satisfies "durable auditable authorization, not loose JSON."
model MediaOrderRevision {
  id                              String    @id @default(cuid())
  businessId                      String
  advertisementId                 String
  platform                        Platform
  placement                       String?
  // Numbered per (advertisementId, platform, placement) — a relaunch to the same destination
  // gets the next number in that sequence, never a new independent counter.
  revision                        Int
  goal                            String
  successEvent                    String
  country                         String
  locationNote                    String?
  // Radius (in miles) around locationNote, once locationNote resolves to a real point — nullable
  // because a country-only revision (no locationNote) has no radius concept at all.
  radiusMiles                     Int?
  dailyBudgetMinor                Int
  currency                        String    @default("USD")
  startAt                         DateTime
  endAt                           DateTime?
  destinationLandingPageId        String?
  destinationLandingPageVersionId String?
  assetIds                        Json // string[], frozen from the Advertisement at this exact moment
  accountName                     String?
  accountCurrency                 String?
  accountTimezone                 String?
  adAccountId                     String?
  // Deterministic hash of the fields above — lets two revisions be compared for "did anything
  // actually change" without a field-by-field diff, and gives each revision a stable fingerprint
  // independent of its row id.
  contentHash                     String
  createdByUserId                 String
  createdAt                       DateTime  @default(now())

  business      Business      @relation(fields: [businessId], references: [id])
  advertisement Advertisement @relation(fields: [advertisementId], references: [id])
  adRuns        AdRun[]

  @@unique([advertisementId, platform, placement, revision])
  @@index([businessId])
  @@index([advertisementId])
}

// ---------- Inbox ----------
// The curated, user-facing home for "what happened and what needs a response" — deliberately
// separate from the concurrent session's Activity feed (a comprehensive internal audit trail of
// every projected domain event) and from Message (outbound campaign sends to an Audience). Inbox
// is neither: it's the surface a business owner actually reads, eventually unifying system
// narration (this pass), inbound/outbound email and SMS (a later, separate migration), and any
// future internal/agent notes into one thread-per-conversation model. The product decision
// recorded 2026-08-28 deliberately keeps this thin — no saved views, no default views, just
// threads and messages — but revised 2026-08-28 (same day, before any real data existed) to fix a
// structural mistake: the first version tied InboxThread to Advertisement via an opaque
// `sourceType`/`sourceId` string pair, which is exactly the kind of ad-shaped assumption that
// would have needed generalizing the moment Contact-based (email/SMS) threads arrived. Inbox owns
// threads; ads and contacts attach to them via real, typed, nullable FKs instead — a Contact
// thread and an Advertisement thread are structurally equal citizens now, not "the ad case plus a
// someday case." `type` names which FK is actually populated (app-level discriminant, not a DB
// constraint — matches this schema's existing precedent, e.g. AttributionEvent.deploymentId/
// adUnitId).
// Generalized 2026-08-28 (schema-only — see CLAUDE.md's "omni inbox" note) to reflect the actual
// product principle: Inbox is a cross-system stream (Contacts, Advertisements, Pages,
// Integrations), not a messages-plus-ads special case. CRM (Lead stage changes, page views on a
// known contact) is deliberately NOT a fifth type here — those events post as messages *into* the
// same CONTACT thread as that person's real communications, per the product's own worked example
// (a Contact thread mixes SMS replies with "Lead status changed" and "Page viewed" system lines
// in one chronological timeline). Only PAGE and INTEGRATION are genuinely new thread kinds, since
// neither is about one specific Contact. No event source for either is wired yet — this is the
// foundation the next slices build on, not a claim that Page/Integration threads exist today.
model InboxThread {
  id              String        @id @default(cuid())
  businessId      String
  type            InboxThreadType
  contactId       String?
  advertisementId String?
  // Only meaningful when type = ADVERTISEMENT — an Advertisement can run on more than one
  // platform at once, so the thread key is the (Advertisement, platform) pair, not the
  // Advertisement alone (see the compound unique below).
  platform        String?
  // Only meaningful when type = PAGE — one thread per landing page (e.g. rolling submission
  // volume), not per submission.
  landingPageId   String?
  // Only meaningful when type = INTEGRATION — which connector this is about (e.g. "META",
  // "TWILIO"). A plain string, not the Platform enum: an integration thread should be able to
  // exist for something that isn't a Platform-enum ad connector at all (Twilio is the product's
  // own example, and no email/SMS provider is installed yet — see CLAUDE.md's Plugins section).
  integrationPlatform String?
  subject         String
  // Simple thread-level read state (revised 2026-08-28's "Messages -> Inbox, keep it narrow"
  // slice) — a thread is unread if its most recent message postdates this. No per-message read
  // state, no saved/default views, matching the explicit narrow scope of that slice.
  lastReadAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  business      Business       @relation(fields: [businessId], references: [id])
  contact       Contact?       @relation(fields: [contactId], references: [id])
  advertisement Advertisement? @relation(fields: [advertisementId], references: [id])
  landingPage   LandingPage?   @relation(fields: [landingPageId], references: [id])
  messages      InboxMessage[]

  // Four independent compound uniques, safe alongside each other precisely because each is scoped
  // to a different `type` in practice — a CONTACT thread has null advertisementId/platform/
  // landingPageId/integrationPlatform, an ADVERTISEMENT thread has null contactId/landingPageId/
  // integrationPlatform, and so on — and MySQL's unique indexes treat every NULL as distinct from
  // every other NULL, so rows of any "other" type never collide on a constraint meant for a
  // different one. Same nullable-unique reasoning already established for Sale.idempotencyKey and
  // AdRun.idempotencyKey elsewhere in this schema. contactId/advertisementId/landingPageId don't
  // need businessId in their own key — each already belongs to exactly one business via its own
  // FK — but integrationPlatform is a bare string with no such natural scoping, so it needs
  // businessId explicitly or two different businesses' "META" integration threads would collide.
  @@unique([contactId])
  @@unique([advertisementId, platform])
  @@unique([landingPageId])
  @@unique([businessId, integrationPlatform])
  @@index([businessId])
}

enum InboxThreadType {
  CONTACT
  ADVERTISEMENT
  PAGE
  INTEGRATION
  // Reserved for a thread that isn't about one specific Contact, Advertisement, Page, or
  // Integration (e.g. a platform-wide notice) — not populated by anything yet, kept only so
  // InboxMessage.direction's INTERNAL case has a home to point at once something needs it.
  SYSTEM
}

enum InboxMessageKind {
  SYSTEM
  // Not produced by anything yet — the transactional email/SMS plugins aren't installed (see
  // CLAUDE.md's Plugins section). Declared now, alongside SYSTEM, so the enum already expresses
  // the full target vocabulary and adding real EMAIL/SMS messages later is a data change, not
  // another schema migration.
  EMAIL
  SMS
}

enum InboxMessageDirection {
  INBOUND
  OUTBOUND
  // Every message this pass produces — LOOPIE narrating to the business owner, not a message from
  // or to an external party on a channel.
  INTERNAL
}

model InboxMessage {
  id        String                 @id @default(cuid())
  threadId  String
  kind      InboxMessageKind       @default(SYSTEM)
  direction InboxMessageDirection  @default(INTERNAL)
  // Nullable — an inbound SMS reply, for instance, has no subject-line concept at all. Every
  // SYSTEM message this pass produces still sets one (see lib/adRunInbox.ts).
  subject   String?
  body      String                 @db.Text
  // Structured detail behind the human-readable subject/body (e.g. { adRunId, event, from, to })
  // — for a future UI to link back to the source object, never itself rendered as prose.
  meta      Json?
  createdAt DateTime               @default(now())

  thread InboxThread @relation(fields: [threadId], references: [id])

  @@index([threadId])
}

model AdRun {
  id                       String                 @id @default(cuid())
  advertisementId          String
  platform                 Platform
  placement                String?
  status                   AdRunStatus            @default(PENDING)
  budget                   Decimal?               @db.Decimal(12, 2)
  startDate                DateTime?
  endDate                  DateTime?
  externalCampaignId       String?
  externalAdSetId          String?
  externalAdId             String?
  previewUrl               String? // Link to see the ad "in the wild"
  managerUrl               String? // Link to open the ad in the platform's manager
  errorMessage             String? // Holds failure reason if status is VALIDATION_FAILED
  spend                    Decimal                @default(0) @db.Decimal(12, 2)
  impressions              Int                    @default(0)
  reach                    Int? // Unique-person reach, distinct from raw impressions — provider-reported, nullable until first synced
  clicks                   Int                    @default(0)
  conversions              Int                    @default(0)
  // Provider delivery truth, pulled by AdRunSyncService — independent of `status` (LOOPIE's own
  // order/lifecycle state) by design. See ProviderDeliveryState's own doc comment.
  providerState            ProviderDeliveryState?
  providerStateRaw         String? // The connector's own unmapped status string, kept for audit/debugging
  syncHealth               SyncHealth             @default(NEVER_SYNCED)
  syncError                String? // Last sync failure reason, cleared on the next successful sync
  effectiveBudget          Decimal?               @db.Decimal(12, 2) // Provider-reported daily budget, for drift comparison against `budget`
  effectiveStartDate       DateTime? // Provider-reported schedule, for drift comparison against `startDate`/`endDate`
  effectiveEndDate         DateTime?
  // Requested targeting — same "current value, live-editable" role budget/startDate/endDate play
  // above. country defaults from the platform connection's own defaultCountry at send time (see
  // MediaOrderRevision.country); locationNote/radiusMiles are null when targeting is country-only.
  country                  String?
  locationNote             String?
  radiusMiles              Int?
  // Provider-reported targeting, for drift comparison against country/locationNote/radiusMiles —
  // same role effectiveBudget/effectiveStartDate play above. effectiveLocationNote is a best-effort
  // human-readable description of whatever the platform's own read-back resolves to (e.g. a
  // resolved location name), not guaranteed to round-trip locationNote's exact original text.
  effectiveCountry         String?
  effectiveLocationNote    String?
  effectiveRadiusMiles     Int?
  // Review/rejection reasons from the platform's own last sync (e.g. Meta's issues_info messages)
  // — string[], null until first synced or when the platform reports none.
  providerIssues           Json?
  lastSyncedAt             DateTime?
  destinationLandingPageId String?
  orderSnapshot            Json?
  // The prior AdRun (same Advertisement) this one replaces, when created via a RECREATE
  // (relaunch/replace-creative/replace-destination) rather than a first send — explicit, queryable
  // lineage alongside the MediaOrderRevision sequence, which only numbers revisions, not runs.
  // That prior run is marked ENDED at the same time this FK is set (see AdRunService), never left
  // live alongside its replacement.
  supersedesRunId          String?
  // The durable, immutable, numbered record this run was actually sent against — see
  // MediaOrderRevision's own doc comment. Nullable only because it postdates orderSnapshot: rows
  // created before this column existed keep orderSnapshot as their sole record; every new send
  // populates both (orderSnapshot stays for the existing frontend read path, unchanged this pass).
  mediaOrderRevisionId     String?
  // Client-supplied dedup key for the declarative create-and-provision command (POST
  // /advertisements/{advertisementId}/runs) — a retry must return the same AdRun and must never
  // trigger a second connector push. Same convention as Sale.idempotencyKey. Nullable at the DB
  // level for the same reason: MySQL's unique index treats multiple NULLs as distinct, so rows
  // created before this column existed (or via direct db.adRun.create in tests) never collide.
  idempotencyKey           String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  advertisement          Advertisement       @relation(fields: [advertisementId], references: [id])
  destinationLandingPage LandingPage?        @relation(fields: [destinationLandingPageId], references: [id])
  mediaOrderRevision     MediaOrderRevision? @relation(fields: [mediaOrderRevisionId], references: [id])
  supersedes             AdRun?              @relation("AdRunSupersedes", fields: [supersedesRunId], references: [id])
  supersededBy           AdRun[]             @relation("AdRunSupersedes")

  attributionEvents    AttributionEvent[]
  leadsSourced         Lead[]                        @relation("LeadSourceAdRun")
  salesSourced         Sale[]                        @relation("SaleSourceAdRun")
  interactions         Interaction[]                 @relation("InteractionSourceAdRun")
  adSpends             AdSpend[]
  campaignLinks        CampaignAdRun[]
  budgetAuthorizations BudgetAuthorization[]
  reconciliations      Reconciliation[]
  ledgerEntries        LedgerEntry[]
  slotAssignments      LandingPageAdSlotAssignment[]

  @@unique([advertisementId, idempotencyKey])
  @@index([advertisementId])
  @@index([destinationLandingPageId])
  @@index([supersedesRunId])
  @@index([mediaOrderRevisionId])
}

// Join table for future-proofing optional Campaign grouping
model CampaignAdRun {
  id         String   @id @default(cuid())
  campaignId String
  adRunId    String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  adRun    AdRun    @relation(fields: [adRunId], references: [id])

  @@unique([campaignId, adRunId])
  @@index([adRunId])
}

model AdvertisementAsset {
  id              String   @id @default(cuid())
  advertisementId String
  assetId         String
  createdAt       DateTime @default(now())

  advertisement Advertisement @relation(fields: [advertisementId], references: [id])
  asset         Asset         @relation(fields: [assetId], references: [id])

  @@unique([advertisementId, assetId])
  @@index([assetId])
}

// @deprecated in favor of Advertisement + AdRun. Kept so existing Deployment rows and FKs compile.
enum DeploymentStatus {
  PENDING
  ACTIVE
  PAUSED
  ENDED
}

// @deprecated in favor of Advertisement
model Deployment {
  id                       String           @id @default(cuid())
  campaignId               String
  creativeId               String
  platform                 Platform
  externalCampaignId       String?
  externalAdSetId          String?
  externalAdId             String?
  status                   DeploymentStatus @default(PENDING)
  spend                    Decimal          @default(0) @db.Decimal(12, 2)
  impressions              Int              @default(0)
  clicks                   Int              @default(0)
  conversions              Int              @default(0)
  lastSyncedAt             DateTime?
  destinationLandingPageId String? // when set, the tracked redirect resolves here instead of campaign.destinationUrl
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  campaign               Campaign     @relation(fields: [campaignId], references: [id])
  creative               Creative     @relation(fields: [creativeId], references: [id])
  destinationLandingPage LandingPage? @relation(fields: [destinationLandingPageId], references: [id])

  attributionEvents AttributionEvent[]
  leadsSourced      Lead[]             @relation("LeadSourceDeployment")
  salesSourced      Sale[]             @relation("SaleSourceDeployment")
  interactions      Interaction[]      @relation("InteractionSourceDeployment")
  adSpends          AdSpend[]

  @@index([campaignId])
  @@index([creativeId])
  @@index([destinationLandingPageId])
}

// Pre-identity click/session tracking. Either deploymentId (external platform) or adUnitId
// (first-party, written by apps/ad-server against this same table) is set, never both —
// enforced in application code, not a DB constraint, to keep both nullable and independent.
model AttributionEvent {
  id            String    @id @default(cuid())
  campaignId    String?
  creativeId    String?
  deploymentId  String?
  adRunId       String?
  adUnitId      String?
  landingPageId String? // set when the click's destination was a LOOPIE-hosted landing page
  platform      Platform?
  sessionId     String
  clickId       String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  createdAt     DateTime  @default(now())

  deployment  Deployment?  @relation(fields: [deploymentId], references: [id])
  adRun       AdRun?       @relation(fields: [adRunId], references: [id])
  adUnit      AdUnit?      @relation(fields: [adUnitId], references: [id])
  landingPage LandingPage? @relation(fields: [landingPageId], references: [id])

  @@index([deploymentId])
  @@index([adUnitId])
  @@index([sessionId])
}

// A business's own referral partners — deliberately unrelated to Deployment/AdUnit (an affiliate
// isn't a paid ad platform) and to Commission/Payout (which stay generic: payeeRef/sourceRef are
// plain strings so the finance schema never needs to know what an "affiliate" is — see
// SaleService.create's payeeRef: `affiliate:${affiliate.id}` convention).
enum CommissionRuleType {
  PERCENTAGE
  FIXED
}

enum PayoutCadence {
  MANUAL
  WEEKLY
  MONTHLY
}

model AffiliateClass {
  id                  String   @id @default(cuid())
  businessId          String
  name                String
  maxAffiliateRateBps Int
  maxManagerShareBps  Int
  defaultDealId       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business    Business        @relation(fields: [businessId], references: [id])
  defaultDeal AffiliateDeal?  @relation("ClassDefaultDeal", fields: [defaultDealId], references: [id])
  deals       AffiliateDeal[] @relation("DealClass")
  affiliates  Affiliate[]

  @@index([businessId])
  @@index([defaultDealId])
}

model AffiliateDeal {
  id                    String             @id @default(cuid())
  businessId            String
  classId               String?
  name                  String
  commissionRuleType    CommissionRuleType @default(PERCENTAGE)
  affiliateRateBps      Int?
  fixedAmountMinor      Int?
  managerShareBps       Int
  eligibilityWindowDays Int?
  payoutThresholdMinor  Int?
  payoutCadence         PayoutCadence      @default(MANUAL)
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  business          Business         @relation(fields: [businessId], references: [id])
  class             AffiliateClass?  @relation("DealClass", fields: [classId], references: [id])
  defaultForClasses AffiliateClass[] @relation("ClassDefaultDeal")
  affiliates        Affiliate[]

  @@index([businessId])
  @@index([classId])
}

model Affiliate {
  id                         String             @id @default(cuid())
  businessId                 String
  name                       String
  email                      String?
  referralCode               String // globally unique like LandingPage.slug — a clean public link, no business-id prefix
  // Policy fields below are leftover from when rate lived on Affiliate. Source of truth is the
  // assigned Deal (class default or dealId) plus optional rate overrides. Do not read these for
  // new commissions or cadence payouts.
  commissionRuleType         CommissionRuleType @default(PERCENTAGE)
  commissionRateBps          Int?
  commissionFixedAmountMinor Int?
  eligibilityWindowDays      Int?
  payoutThresholdMinor       Int?
  payoutCadence              PayoutCadence      @default(MANUAL)
  lastPayoutAt               DateTime?
  classId                    String?
  dealId                     String?
  managerId                  String?
  userId                     String?            @unique
  affiliateRateOverrideBps   Int?
  managerShareOverrideBps    Int?
  destinationLandingPageId   String?
  destinationUrl             String? // fallback if no landing page set — same pattern as Campaign.destinationUrl / Deployment.destinationLandingPageId
  stripeConnectAccountId     String?            @unique
  stripePayoutsEnabled       Boolean            @default(false)
  stripeDetailsSubmitted     Boolean            @default(false)
  stripeDisabledReason       String?
  isActive                   Boolean            @default(true)
  pausedAt                   DateTime?
  createdAt                  DateTime           @default(now())

  business               Business                 @relation(fields: [businessId], references: [id])
  class                  AffiliateClass?          @relation(fields: [classId], references: [id])
  deal                   AffiliateDeal?           @relation(fields: [dealId], references: [id])
  manager                Affiliate?               @relation("AffiliateManager", fields: [managerId], references: [id])
  downline               Affiliate[]              @relation("AffiliateManager")
  user                   User?                    @relation(fields: [userId], references: [id])
  destinationLandingPage LandingPage?             @relation(fields: [destinationLandingPageId], references: [id])
  clicks                 AffiliateReferralClick[]
  referringSplits        SaleAffiliateSplit[]     @relation("SplitReferrer")
  managerSplits          SaleAffiliateSplit[]     @relation("SplitManager")

  @@unique([referralCode])
  @@index([businessId])
  @@index([classId])
  @@index([dealId])
  @@index([managerId])
  @@index([destinationLandingPageId])
}

// Pre-identity click/session tracking for affiliate referrals — mirrors AttributionEvent's role
// but kept as its own table rather than overloading AttributionEvent's campaign/deployment/ad-unit
// shape with an unrelated concept.
model AffiliateReferralClick {
  id            String   @id @default(cuid())
  affiliateId   String
  sessionId     String
  landingPageId String?
  clickedAt     DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([sessionId])
}

// ---------- Lead / Sale / Interaction (the shared spine) ----------

enum SourceType {
  MESSAGE
  DEPLOYMENT
  AD_RUN
  AD_UNIT
  MANUAL
  IMPORT
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  WON
  LOST
}

model Lead {
  id                   String     @id @default(cuid())
  businessId           String
  contactId            String
  stage                LeadStage  @default(NEW)
  owner                String?
  estimatedValue       Decimal?   @db.Decimal(12, 2)
  sourceType           SourceType
  sourceMessageId      String?
  sourceDeploymentId   String?
  sourceAdRunId        String?
  sourceAdUnitId       String?
  clickId              String?
  landingSessionId     String?
  // Which affiliate (if any) referred this lead — deliberately separate from sourceType/source*Id
  // above (those answer "how did this lead reach us"; this answers "who gets credit"), stamped
  // once at creation only (see resolveContactAndLead in lib/identityResolution.ts). Plain field,
  // not a relation, matching this schema's no-new-FK-sprawl pattern for loose cross-references.
  referringAffiliateId String?
  // 'OPEN' while stage is not WON/LOST; null once closed. Unique with contactId so
  // concurrent form submits cannot insert a second active lead for the same person.
  openSlot             String?
  openedAt             DateTime   @default(now())
  closedAt             DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  business         Business         @relation(fields: [businessId], references: [id])
  contact          Contact          @relation(fields: [contactId], references: [id])
  sourceMessage    Message?         @relation("LeadSourceMessage", fields: [sourceMessageId], references: [id])
  sourceDeployment Deployment?      @relation("LeadSourceDeployment", fields: [sourceDeploymentId], references: [id])
  sourceAdRun      AdRun?           @relation("LeadSourceAdRun", fields: [sourceAdRunId], references: [id])
  sourceAdUnit     AdUnit?          @relation("LeadSourceAdUnit", fields: [sourceAdUnitId], references: [id])
  sales            Sale[]
  formSubmissions  FormSubmission[]

  @@unique([contactId, openSlot])
  @@index([businessId, stage])
  @@index([contactId])
  @@index([sourceMessageId])
  @@index([sourceDeploymentId])
  @@index([sourceAdRunId])
  @@index([sourceAdUnitId])
}

model Sale {
  id                 String     @id @default(cuid())
  businessId         String
  contactId          String
  leadId             String?
  amount             Decimal    @db.Decimal(12, 2)
  date               DateTime
  productOrService   String?
  sourceType         SourceType
  sourceMessageId    String?
  sourceDeploymentId String?
  sourceAdRunId      String?
  sourceAdUnitId     String?
  notes              String?    @db.Text
  // Nullable timestamp, not a status enum — matches Lead.closedAt/Automation.pausedAt. Set by
  // POST /sales/{saleId}/reverse; the linked Commission (if any) is reversed through
  // FinanceService.reverseCommission, not mutated directly.
  reversedAt         DateTime?
  // Client-supplied dedup key for POST /sales — required by the API contract for every new sale
  // (see SaleService.create's requireIdempotencyKey), same convention as every finance model
  // (Payment/Commission/etc: `@@unique([businessId, idempotencyKey])`). Nullable at the DB level
  // only so the 4 pre-existing Sale rows in the shared dev DB (predating this column) don't block
  // a `db push` with a NOT NULL violation — MySQL's unique index treats multiple NULLs as
  // distinct, so those legacy rows never collide with each other or with new keyed rows.
  idempotencyKey     String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  business         Business            @relation(fields: [businessId], references: [id])
  contact          Contact             @relation(fields: [contactId], references: [id])
  lead             Lead?               @relation(fields: [leadId], references: [id])
  sourceMessage    Message?            @relation("SaleSourceMessage", fields: [sourceMessageId], references: [id])
  sourceDeployment Deployment?         @relation("SaleSourceDeployment", fields: [sourceDeploymentId], references: [id])
  sourceAdRun      AdRun?              @relation("SaleSourceAdRun", fields: [sourceAdRunId], references: [id])
  sourceAdUnit     AdUnit?             @relation("SaleSourceAdUnit", fields: [sourceAdUnitId], references: [id])
  affiliateSplit   SaleAffiliateSplit?
  externalEvents   ExternalEvent[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, date])
  @@index([contactId])
  @@index([sourceMessageId])
  @@index([sourceDeploymentId])
  @@index([sourceAdRunId])
  @@index([sourceAdUnitId])
}

// Frozen economics for one Sale. Written once when the Sale is created; never updated.
// Live Deal/Class/manager changes must not alter these values or the Commission payees.
model SaleAffiliateSplit {
  id                       String             @id @default(cuid())
  saleId                   String             @unique
  referringAffiliateId     String
  managerAffiliateId       String?
  commissionRuleType       CommissionRuleType
  grossAffiliateRateBps    Int
  fixedAmountMinor         Int?
  managerShareBps          Int
  affiliateNetBps          Int
  eligibilityWindowDays    Int?
  saleAmountMinor          Int
  grossCommissionMinor     Int
  managerCommissionMinor   Int
  affiliateCommissionMinor Int
  createdAt                DateTime           @default(now())

  sale               Sale       @relation(fields: [saleId], references: [id])
  referringAffiliate Affiliate  @relation("SplitReferrer", fields: [referringAffiliateId], references: [id])
  managerAffiliate   Affiliate? @relation("SplitManager", fields: [managerAffiliateId], references: [id])

  @@index([referringAffiliateId])
  @@index([managerAffiliateId])
}

enum InteractionType {
  EMAIL_SENT
  TEXT_SENT
  SOCIAL_POST_SENT
  REPLY
  CALL_LOGGED
  NOTE
  STATUS_CHANGE
  QUOTE_SENT
  SALE_RECORDED
  AD_CLICK
  FORM_SUBMITTED
  PAGE_VIEWED
}

model Interaction {
  id                 String          @id @default(cuid())
  businessId         String
  contactId          String
  type               InteractionType
  sourceType         SourceType?
  sourceMessageId    String?
  sourceDeploymentId String?
  sourceAdRunId      String?
  sourceAdUnitId     String?
  metadata           Json?
  occurredAt         DateTime        @default(now())
  createdAt          DateTime        @default(now())

  business         Business    @relation(fields: [businessId], references: [id])
  contact          Contact     @relation(fields: [contactId], references: [id])
  sourceMessage    Message?    @relation("InteractionSourceMessage", fields: [sourceMessageId], references: [id])
  sourceDeployment Deployment? @relation("InteractionSourceDeployment", fields: [sourceDeploymentId], references: [id])
  sourceAdRun      AdRun?      @relation("InteractionSourceAdRun", fields: [sourceAdRunId], references: [id])
  sourceAdUnit     AdUnit?     @relation("InteractionSourceAdUnit", fields: [sourceAdUnitId], references: [id])

  @@index([contactId, occurredAt])
  @@index([businessId, occurredAt])
}

// ---------- Landing Pages ----------
//
// Authoring is intentionally constrained to a structured, template-driven model — not a
// freeform builder. LandingPageTemplate.schema and LandingPage.content/theme share one
// versioned JSON shape (see LandingPageTemplate doc comment below) so a future external
// template catalog ("Formerly") can supply templates LOOPIE imports without a schema change.
//
// LandingPageTemplate -> LandingPage (draft working copy) -> PublishedPageVersion (immutable).

model LandingPageTemplate {
  id              String   @id @default(cuid())
  businessId      String? // null = system template (ships with LOOPIE or imported from a catalog)
  isSystem        Boolean  @default(false)
  name            String
  description     String?
  category        String? // free-form for V1: "lead-gen", "event", "promo", ...
  formatVersion   String   @default("1.0") // versions the schema shape below, independent of LOOPIE's own release
  previewImageUrl String?
  // { sections: [{ key, type, order, hideable, editable: string[] }], themeTokens: string[] }
  // — a structured manifest of what an author may edit, not markup. Rendering (hosted page
  // and export) walks this against LandingPage.content/theme; see LandingPageRenderer.
  schema          Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business?     @relation(fields: [businessId], references: [id])
  pages    LandingPage[]

  @@index([businessId])
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LandingPage {
  id                 String     @id @default(cuid())
  businessId         String
  templateId         String
  formId             String?
  name               String // internal name
  slug               String     @unique // hosted at /p/{slug}; globally unique so custom domains can map 1:1 later
  slugAutoManaged    Boolean    @default(true) // true = slug still auto-derives from name on every draft save; false once explicitly edited or once first published — see LandingPageService.update/publish
  customDomain       String? // domain-ready: DNS/cert provisioning is out of scope for V1, field exists so the mapping has somewhere to live
  status             PageStatus @default(DRAFT)
  content            Json // current draft working copy, shaped per template.schema
  theme              Json? // theme tokens (brand colors, fonts) — kept distinct from content per the brief's "theme tokens/branding" callout
  publishedVersionId String?    @unique
  formStartCount     Int        @default(0) // approximate, not deduplicated by session — see LandingPageService
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  business         Business               @relation(fields: [businessId], references: [id])
  template         LandingPageTemplate    @relation(fields: [templateId], references: [id])
  form             Form?                  @relation(fields: [formId], references: [id])
  publishedVersion PublishedPageVersion?  @relation("CurrentPublished", fields: [publishedVersionId], references: [id])
  versions         PublishedPageVersion[] @relation("PageVersions")

  deployments       Deployment[]
  adRuns            AdRun[]
  adUnits           AdUnit[]
  affiliates        Affiliate[]
  attributionEvents AttributionEvent[]
  pageViews         PageView[]
  formSubmissions   FormSubmission[]
  adSlots           LandingPageAdSlot[]
  inboxThreads      InboxThread[]

  @@index([businessId, status])
}

enum AdSlotPlacement {
  AFTER_HERO
  BEFORE_FORM
  AFTER_FORM
  BOTTOM
}

// A page is a publishing surface: N spaces, each holding at most one first-party AdUnit.
// Draft slots live here; publish freezes them onto PublishedPageVersion.adSlotSnapshot.
model LandingPageAdSlot {
  id            String          @id @default(cuid())
  landingPageId String
  sortOrder     Int
  placement     AdSlotPlacement
  createdAt     DateTime        @default(now())

  landingPage LandingPage                   @relation(fields: [landingPageId], references: [id])
  assignments LandingPageAdSlotAssignment[]

  @@index([landingPageId])
}

model LandingPageAdSlotAssignment {
  id        String      @id @default(cuid())
  slotId    String
  adRunId   String
  status    AdRunStatus @default(ACTIVE)
  weight    Int         @default(1)
  createdAt DateTime    @default(now())

  slot  LandingPageAdSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  adRun AdRun             @relation(fields: [adRunId], references: [id], onDelete: Cascade)

  @@index([slotId])
  @@index([adRunId])
}

// Immutable snapshot written on every publish — content/theme/formId frozen at that moment,
// so editing a draft after publishing never changes what's already live or already reported on.
model PublishedPageVersion {
  id             String    @id @default(cuid())
  landingPageId  String
  version        Int
  content        Json
  theme          Json?
  formId         String?
  // Frozen copy of the Form's submitLabel/successMessage/fields as they were at publish time —
  // formId alone is just a pointer to a live, mutable Form row, so without this, editing a
  // Form's fields after publishing would silently change what an already-published page renders
  // and validates against. Null for versions published before this field existed and for pages
  // with no form attached (see CLAUDE.md "Landing-Page Capture Immutability").
  formSnapshot   Json?
  adSlotSnapshot Json?
  // Frozen template schema at publish time. The live LandingPage.templateId can change in draft
  // (layout switch) without rewriting this, so /p/{slug} keeps rendering the published layout.
  schemaSnapshot Json?
  publishedAt    DateTime  @default(now())
  publishedBy    String? // userId — no admin/RBAC in V1, kept optional
  archivedAt     DateTime? // set when a newer version supersedes this one; row is kept for history

  landingPage LandingPage  @relation("PageVersions", fields: [landingPageId], references: [id])
  currentFor  LandingPage? @relation("CurrentPublished")

  formSubmissions FormSubmission[]

  @@unique([landingPageId, version])
  @@index([landingPageId])
}

// One row per page view. Lower-volume than ad impressions (which use counters on
// AdUnit/Deployment instead — see AdUnit), and unique-session counting needs distinct rows.
model PageView {
  id                     String   @id @default(cuid())
  landingPageId          String
  publishedPageVersionId String?
  sessionId              String?
  referrer               String?
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  occurredAt             DateTime @default(now())

  landingPage LandingPage @relation(fields: [landingPageId], references: [id])

  @@index([landingPageId, occurredAt])
  @@index([sessionId])
}

// ---------- Forms ----------
//
// First-class and reusable — not JSON embedded in a page — so the same Form can be reused
// across landing pages, and a submission always resolves through one canonical path.

model Form {
  id             String    @id @default(cuid())
  businessId     String
  name           String
  submitLabel    String    @default("Submit")
  successMessage String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  business    Business         @relation(fields: [businessId], references: [id])
  fields      FormField[]
  pages       LandingPage[]
  submissions FormSubmission[]

  @@index([businessId])
}

enum FormFieldType {
  TEXT
  EMAIL
  PHONE
  TEXTAREA
  SELECT
  CHECKBOX
  HIDDEN
}

model FormField {
  id        String        @id @default(cuid())
  formId    String
  label     String
  fieldKey  String // stable key used in submission payloads, e.g. "email"
  type      FormFieldType
  required  Boolean       @default(false)
  options   Json? // string[] of choices, used when type = SELECT
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  form Form @relation(fields: [formId], references: [id])

  @@unique([formId, fieldKey])
  @@index([formId])
}

// The raw capture record. Submitting also creates/updates a Lead (and Contact if new) through
// the same identity-transition path as attribution/form-submit — see AttributionService /
// LandingPageService.submit. Preserves everything needed to attribute the resulting Lead:
// session, click, UTMs, and whichever of Deployment/AdUnit/LandingPage produced the visit.
model FormSubmission {
  id                     String   @id @default(cuid())
  businessId             String
  formId                 String
  landingPageId          String?
  publishedPageVersionId String?
  contactId              String?
  leadId                 String?
  data                   Json // raw field values keyed by fieldKey
  sessionId              String?
  clickId                String?
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  utmContent             String?
  utmTerm                String?
  sourceDeploymentId     String?
  sourceAdRunId          String?
  sourceAdUnitId         String?
  createdAt              DateTime @default(now())

  business             Business              @relation(fields: [businessId], references: [id])
  form                 Form                  @relation(fields: [formId], references: [id])
  landingPage          LandingPage?          @relation(fields: [landingPageId], references: [id])
  publishedPageVersion PublishedPageVersion? @relation(fields: [publishedPageVersionId], references: [id])
  contact              Contact?              @relation(fields: [contactId], references: [id])
  lead                 Lead?                 @relation(fields: [leadId], references: [id])

  @@unique([landingPageId, sessionId])
  @@index([businessId, createdAt])
  @@index([formId])
  @@index([sessionId])
}

// ---------- First-party advertising (AdUnit) ----------
//
// A Deployment represents creative running on an EXTERNAL ad platform (Meta/Google/TikTok) —
// we don't control serving, only sync status/spend/metrics back in. An AdUnit is creative WE
// serve ourselves via apps/ad-server: a genuinely different delivery mechanism, so it is a
// separate model rather than an overloaded Deployment. Both point at the same Creative and
// both feed the same Lead/Sale/attribution spine through the SourceType.AD_UNIT arm.

enum AdUnitFormat {
  DISPLAY_BANNER
  NATIVE
  EMBED
}

enum AdUnitStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

model AdUnit {
  id                       String       @id @default(cuid())
  businessId               String
  campaignId               String
  creativeId               String
  format                   AdUnitFormat
  status                   AdUnitStatus @default(DRAFT)
  destinationLandingPageId String? // preferred destination when set
  destinationUrl           String? // fallback external destination when no landing page is set
  servingConfig            Json? // format-specific serving options (dimensions, autoplay, ...) — free-form like Audience.filter
  impressions              Int          @default(0) // counter, incremented by apps/ad-server on every impression — cheap, no per-row write
  clicks                   Int          @default(0)
  conversions              Int          @default(0)
  lastServedAt             DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  business               Business     @relation(fields: [businessId], references: [id])
  campaign               Campaign     @relation(fields: [campaignId], references: [id])
  creative               Creative     @relation(fields: [creativeId], references: [id])
  destinationLandingPage LandingPage? @relation(fields: [destinationLandingPageId], references: [id])

  attributionEvents AttributionEvent[]
  leadsSourced      Lead[]             @relation("LeadSourceAdUnit")
  salesSourced      Sale[]             @relation("SaleSourceAdUnit")
  interactions      Interaction[]      @relation("InteractionSourceAdUnit")
  adSpends          AdSpend[]

  @@index([businessId])
  @@index([campaignId])
  @@index([creativeId])
  @@index([destinationLandingPageId])
}

// ---------- Reporting rollups (populated opportunistically; Results also computes live) ----------

enum PerformanceEntityType {
  MESSAGE
  CAMPAIGN
  CREATIVE
  DEPLOYMENT
  LANDING_PAGE
  AD_UNIT
}

model PerformanceSnapshot {
  id             String                @id @default(cuid())
  businessId     String
  entityType     PerformanceEntityType
  entityId       String
  period         String // e.g. "2026-08" or "2026-08-25" bucket key
  sentOrViews    Int                   @default(0)
  openedOrClicks Int                   @default(0)
  replied        Int                   @default(0)
  leads          Int                   @default(0)
  sales          Int                   @default(0)
  revenue        Decimal               @default(0) @db.Decimal(12, 2)
  spend          Decimal?              @db.Decimal(12, 2)
  createdAt      DateTime              @default(now())

  @@unique([entityType, entityId, period])
  @@index([businessId, entityType])
}

// ---------- Money & Ledger ----------
//
// Double-entry ledger. Balances are always derived from LedgerEntry rows — FinancialAccount
// has no stored balance field. Posted LedgerTransaction/LedgerEntry rows are immutable;
// corrections create a reversing transaction rather than editing history.
// Campaign.budget remains an operational planning field and is not the financial source of truth.
// Path: Campaign → BudgetAuthorization → client funds → AdSpend → ledger.

enum AccountKind {
  CLIENT_AD_FUNDS
  CLIENT_FUNDS_RESERVED
  LOOPIE_CASH
  PROCESSOR_CLEARING
  AD_PLATFORM_CLEARING
  LOOPIE_REVENUE
  AFFILIATE_PAYABLE
  REFUNDS_CREDITS
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerTransactionType {
  CLIENT_FUNDING
  CREDIT
  REFUND
  REVERSAL
  BUDGET_RESERVE
  AD_SPEND
  AD_SPEND_SETTLEMENT
  LOOPIE_FEE
  SERVICE_PAYMENT
  COMMISSION
  PAYOUT
  ADJUSTMENT
}

enum LedgerTransactionStatus {
  POSTED
}

enum PaymentStatus {
  POSTED
  REFUNDED
  FAILED
}

enum RefundStatus {
  POSTED
}

enum BudgetAuthorizationStatus {
  ACTIVE
  RELEASED
}

enum AdSpendSettlementStatus {
  REPORTED
  RECONCILED
  SETTLED
  DISPUTED
}

enum CommissionStatus {
  PENDING
  PAYABLE
  PAID
  CANCELLED
  REVERSED
}

enum PayoutStatus {
  // PENDING: payout row created; Connect transfer not confirmed.
  // TRANSFERRED: funds sit on the affiliate's connected Stripe account (LOOPIE payable discharged).
  // PAID: Stripe reports the connected-account payout reached the bank rail.
  // FAILED / REVERSED as needed. Manual payouts still jump to PAID.
  PENDING
  TRANSFERRED
  PAID
  FAILED
  REVERSED
}

enum ReconciliationStatus {
  MATCHED
  DISCREPANCY
  RESOLVED
}

model FinancialAccount {
  id         String      @id @default(cuid())
  businessId String
  kind       AccountKind
  currency   String      @db.VarChar(3)
  name       String
  createdAt  DateTime    @default(now())

  business Business      @relation(fields: [businessId], references: [id])
  entries  LedgerEntry[]

  @@unique([businessId, kind, currency])
  @@index([businessId])
}

// Immutable once posted. Status never changes; a reversal is a new row pointing here.
model LedgerTransaction {
  id                    String                  @id @default(cuid())
  businessId            String
  currency              String                  @db.VarChar(3)
  type                  LedgerTransactionType
  status                LedgerTransactionStatus @default(POSTED)
  idempotencyKey        String
  externalRef           String?
  externalProvider      String?
  metadata              Json?
  reversesTransactionId String?                 @unique
  postedAt              DateTime                @default(now())
  createdAt             DateTime                @default(now())

  business   Business           @relation(fields: [businessId], references: [id])
  reverses   LedgerTransaction? @relation("LedgerReversal", fields: [reversesTransactionId], references: [id])
  reversedBy LedgerTransaction? @relation("LedgerReversal")
  entries    LedgerEntry[]

  payments             Payment[]
  refunds              Refund[]
  budgetAuthorizations BudgetAuthorization[]
  adSpends             AdSpend[]             @relation("AdSpendPosted")
  adSpendSettlements   AdSpend[]             @relation("AdSpendSettled")
  commissions          Commission[]
  payouts              Payout[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, postedAt])
  @@index([businessId, externalRef])
}

model LedgerEntry {
  id            String          @id @default(cuid())
  businessId    String
  transactionId String
  accountId     String
  campaignId    String? // @deprecated
  adRunId       String?
  direction     LedgerDirection
  amountMinor   Int
  currency      String          @db.VarChar(3)
  createdAt     DateTime        @default(now())

  business    Business          @relation(fields: [businessId], references: [id])
  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     FinancialAccount  @relation(fields: [accountId], references: [id])
  campaign    Campaign?         @relation(fields: [campaignId], references: [id])
  adRun       AdRun?            @relation(fields: [adRunId], references: [id])

  @@index([businessId, accountId])
  @@index([transactionId])
  @@index([campaignId])
  @@index([adRunId])
}

model Payment {
  id                    String        @id @default(cuid())
  businessId            String
  amountMinor           Int
  currency              String        @db.VarChar(3)
  status                PaymentStatus @default(POSTED)
  processor             String?
  externalRef           String?
  stripePaymentIntentId String?
  stripeChargeId        String?
  idempotencyKey        String
  ledgerTransactionId   String
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  business          Business          @relation(fields: [businessId], references: [id])
  ledgerTransaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id])
  refunds           Refund[]

  @@unique([businessId, idempotencyKey])
  @@unique([businessId, externalRef])
  @@index([businessId, createdAt])
  @@index([ledgerTransactionId])
}

model Refund {
  id                  String       @id @default(cuid())
  businessId          String
  paymentId           String?
  amountMinor         Int
  currency            String       @db.VarChar(3)
  status              RefundStatus @default(POSTED)
  reason              String?
  idempotencyKey      String
  ledgerTransactionId String
  createdAt           DateTime     @default(now())

  business          Business          @relation(fields: [businessId], references: [id])
  payment           Payment?          @relation(fields: [paymentId], references: [id])
  ledgerTransaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id])

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([paymentId])
  @@index([ledgerTransactionId])
}

model BudgetAuthorization {
  id                    String                    @id @default(cuid())
  businessId            String
  campaignId            String? // @deprecated
  adRunId               String?
  currency              String                    @db.VarChar(3)
  authorizedAmountMinor Int
  status                BudgetAuthorizationStatus @default(ACTIVE)
  idempotencyKey        String
  ledgerTransactionId   String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  business          Business           @relation(fields: [businessId], references: [id])
  campaign          Campaign?          @relation(fields: [campaignId], references: [id])
  adRun             AdRun?             @relation(fields: [adRunId], references: [id])
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])
  adSpends          AdSpend[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([campaignId])
  @@index([adRunId])
  @@index([ledgerTransactionId])
}

model AdSpend {
  id                      String                  @id @default(cuid())
  businessId              String
  campaignId              String? // @deprecated
  adRunId                 String?
  budgetAuthorizationId   String?
  deploymentId            String?
  adUnitId                String?
  platform                Platform
  externalChargeId        String
  periodStart             DateTime
  periodEnd               DateTime
  currency                String                  @db.VarChar(3)
  reportedAmountMinor     Int
  settledAmountMinor      Int                     @default(0)
  settlementStatus        AdSpendSettlementStatus @default(REPORTED)
  idempotencyKey          String
  ledgerTransactionId     String?
  settlementTransactionId String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  business              Business             @relation(fields: [businessId], references: [id])
  campaign              Campaign?            @relation(fields: [campaignId], references: [id])
  adRun                 AdRun?               @relation(fields: [adRunId], references: [id])
  budgetAuthorization   BudgetAuthorization? @relation(fields: [budgetAuthorizationId], references: [id])
  deployment            Deployment?          @relation(fields: [deploymentId], references: [id])
  adUnit                AdUnit?              @relation(fields: [adUnitId], references: [id])
  ledgerTransaction     LedgerTransaction?   @relation("AdSpendPosted", fields: [ledgerTransactionId], references: [id])
  settlementTransaction LedgerTransaction?   @relation("AdSpendSettled", fields: [settlementTransactionId], references: [id])
  reconciliations       Reconciliation[]

  @@unique([businessId, idempotencyKey])
  @@unique([businessId, externalChargeId])
  @@index([businessId, campaignId])
  @@index([businessId, adRunId])
  @@index([deploymentId])
  @@index([adUnitId])
  @@index([ledgerTransactionId])
  @@index([settlementTransactionId])
}

model Commission {
  id                  String           @id @default(cuid())
  businessId          String
  payeeRef            String
  amountMinor         Int
  currency            String           @db.VarChar(3)
  status              CommissionStatus @default(PENDING)
  sourceRef           String?
  idempotencyKey      String
  ledgerTransactionId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  business          Business           @relation(fields: [businessId], references: [id])
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])
  payoutItem        PayoutItem?

  @@unique([businessId, idempotencyKey])
  @@index([businessId, status])
  @@index([ledgerTransactionId])
}

model Payout {
  id                  String       @id @default(cuid())
  businessId          String
  payeeRef            String
  amountMinor         Int
  currency            String       @db.VarChar(3)
  status              PayoutStatus @default(PAID)
  idempotencyKey      String
  ledgerTransactionId String?
  stripeTransferId    String?      @unique
  stripePayoutId      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  business          Business           @relation(fields: [businessId], references: [id])
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])
  items             PayoutItem[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, status])
  @@index([ledgerTransactionId])
}

model PayoutItem {
  id           String   @id @default(cuid())
  payoutId     String
  commissionId String   @unique
  amountMinor  Int
  createdAt    DateTime @default(now())

  payout     Payout     @relation(fields: [payoutId], references: [id])
  commission Commission @relation(fields: [commissionId], references: [id])

  @@index([payoutId])
}

model Reconciliation {
  id                          String               @id @default(cuid())
  businessId                  String
  campaignId                  String? // @deprecated
  adRunId                     String?
  adSpendId                   String?
  currency                    String               @db.VarChar(3)
  trackedAmountMinor          Int
  platformReportedAmountMinor Int
  settledAmountMinor          Int
  discrepancyMinor            Int
  status                      ReconciliationStatus
  notes                       String?
  idempotencyKey              String
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  business Business  @relation(fields: [businessId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  adRun    AdRun?    @relation(fields: [adRunId], references: [id])
  adSpend  AdSpend?  @relation(fields: [adSpendId], references: [id])

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([campaignId])
  @@index([adRunId])
  @@index([adSpendId])
}

// ---------- CRM customer graph ----------
//
// Person is Contact. Source systems are Integration + ExternalContactRecord.
// CSV is not an Integration; ImportJob writes ExternalContactRecord with provider CSV.
// Do not reuse PlatformConnection (ad-platform OAuth). Capabilities live on Integration
// and in the provider catalog — consumers must not switch on provider names.

enum CrmProvider {
  HUBSPOT
  SALESFORCE
  SHOPIFY
  SQUARE
  PIPEDRIVE
  CSV
}

enum IntegrationStatus {
  INCOMPLETE
  CONNECTED
  NEEDS_REAUTH
  PAUSED
}

enum SyncDirection {
  INBOUND
}

enum ContactIdentifierKind {
  EMAIL
  PHONE
}

enum ExternalMatchStatus {
  LINKED
  UNMATCHED
  AMBIGUOUS
}

enum ExternalEventType {
  CONTACT_CREATED
  CONTACT_UPDATED
  DEAL_WON
  ORDER_CREATED
  PAYMENT_COMPLETED
  APPOINTMENT_COMPLETED
  CUSTOMER_TAGGED
}

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Integration {
  id                String            @id @default(cuid())
  businessId        String
  provider          CrmProvider
  label             String?
  externalAccountId String?
  status            IntegrationStatus @default(INCOMPLETE)
  syncDirection     SyncDirection     @default(INBOUND)
  lastSyncAt        DateTime?
  syncCursor        String?
  capabilities      Json
  credentialsEnc    String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  business       Business                @relation(fields: [businessId], references: [id])
  identifiers    ContactIdentifier[]
  contactRecords ExternalContactRecord[]
  events         ExternalEvent[]

  @@unique([businessId, provider, externalAccountId])
  @@index([businessId, provider])
}

model ImportJob {
  id         String          @id @default(cuid())
  businessId String
  status     ImportJobStatus @default(COMPLETED)
  created    Int             @default(0)
  linked     Int             @default(0)
  ambiguous  Int             @default(0)
  skipped    Int             @default(0)
  // Set only on status FAILED — the sync-job lifecycle must never leave a run stuck looking
  // "in progress" forever with no visible reason it stopped.
  error      String?         @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  business Business                @relation(fields: [businessId], references: [id])
  records  ExternalContactRecord[]

  @@index([businessId, createdAt])
}

model ContactIdentifier {
  id              String                @id @default(cuid())
  businessId      String
  contactId       String
  kind            ContactIdentifierKind
  normalizedValue String
  source          String
  integrationId   String?
  isPrimary       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  contact     Contact      @relation(fields: [contactId], references: [id])
  integration Integration? @relation(fields: [integrationId], references: [id])

  @@unique([businessId, kind, normalizedValue])
  @@index([contactId])
}

model ExternalContactRecord {
  id                  String              @id @default(cuid())
  businessId          String
  contactId           String?
  integrationId       String?
  importJobId         String?
  provider            CrmProvider
  externalId          String
  scopeKey            String
  matchStatus         ExternalMatchStatus @default(LINKED)
  candidateContactIds Json?
  externalUpdatedAt   DateTime?
  syncedAt            DateTime?
  raw                 Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  integration Integration? @relation(fields: [integrationId], references: [id])
  importJob   ImportJob?   @relation(fields: [importJobId], references: [id])

  @@unique([scopeKey, externalId])
  @@index([businessId, matchStatus])
  @@index([contactId])
}

model ExternalEvent {
  id              String            @id @default(cuid())
  businessId      String
  integrationId   String?
  contactId       String?
  saleId          String?
  provider        CrmProvider
  type            ExternalEventType
  externalEventId String
  scopeKey        String
  occurredAt      DateTime
  payload         Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  integration Integration? @relation(fields: [integrationId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  sale        Sale?        @relation(fields: [saleId], references: [id])

  @@unique([scopeKey, externalEventId])
  @@index([businessId, type])
  @@index([contactId])
}

model LoopieSession {
  id                String   @id
  businessId        String
  firstAdRunId      String?
  firstDeploymentId String?
  firstSourceType   String?
  platformClickIds  Json?
  utms              Json?
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, lastSeenAt])
}

// ---------- Rate limiting ----------

// A shared, DB-backed fixed-window counter for public-endpoint rate limiting — used by both
// apps/server and apps/ad-server (see lib/rateLimit.ts in this package), which is why it lives
// here rather than in either app: a process-local in-memory Map only limits traffic reaching that
// one process, so it silently stops working the moment there's more than one instance (Railway
// horizontal scaling) or after any restart. `key` already encodes the window boundary (see
// consumeRateLimit), so a plain upsert is race-free without needing row locks or raw SQL.
// `expiresAt` is one full window past the bucket's own window, kept for the periodic cleanup
// sweep to know when it's safe to delete.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

// ---------- Activity Command Center ----------

enum ActivitySourceKind {
  LOOPIE
  PLATFORM
  WEBSITE
  CHANNEL
  USER
  AUTOMATION
}

enum ActivityAttentionState {
  INFORMATION
  ACTION_REQUIRED
  FAILURE
}

model ActivityItem {
  id         String @id @default(cuid())
  businessId String

  // Stable source identity for idempotency
  sourceKind       ActivitySourceKind
  sourceRecordType String
  sourceRecordId   String
  eventKey         String

  taxonomyVersion String
  type            String

  occurredAt  DateTime
  observedAt  DateTime
  projectedAt DateTime @default(now())

  storyId String

  // Denormalized source info for querying
  sourceLabel     String
  sourceAccountId String?

  // Actor info
  actorKind  String // CONTACT, USER, SYSTEM, AUTOMATION
  actorId    String?
  actorLabel String

  status    String?
  attention ActivityAttentionState
  summary   String
  detail    String?                @db.Text

  // Explicit canonical references
  personId    String?
  leadId      String?
  adId        String?
  runId       String?
  pageId      String?
  formId      String?
  messageId   String?
  broadcastId String?
  saleId      String?

  // Polymorphic extras
  aggregation Json?
  actions     Json?

  attentionItem AttentionItem?

  // Constraint for idempotency: The same canonical event projects into the same Activity item
  @@unique([businessId, sourceKind, sourceRecordType, sourceRecordId, eventKey])
  // Expected query shape indexes
  @@index([businessId, occurredAt])
  @@index([businessId, type])
  @@index([businessId, sourceKind])
  @@index([businessId, attention])
  // High-value reference lookups
  @@index([businessId, personId])
  @@index([businessId, runId])
  @@index([businessId, messageId])
}

model ActivityProjectionFailure {
  id               String    @id @default(cuid())
  businessId       String
  sourceRecordType String
  sourceRecordId   String
  error            String    @db.Text
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([businessId, resolvedAt])
}



enum AttentionItemState {
  NEEDS_ACTION
  IN_PROGRESS
  SNOOZED
  RESOLVED
}

model AttentionItem {
  id           String             @id @default(cuid())
  activityId   String             @unique
  state        AttentionItemState @default(NEEDS_ACTION)
  assigneeId   String?
  priority     String?
  dueAt        DateTime?
  snoozedUntil DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  activityItem ActivityItem @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model ActivitySeenState {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  seenAt     DateTime

  @@unique([userId, businessId])
}

// A named, reusable preset of Activity stream filter query params (source/type/needsAction/...) —
// see ActivityFilters.tsx's "Save View" action and ActivitySidebar.tsx's list. Filters is a plain
// string-keyed bag mirroring the same query params /activity itself accepts, not a typed schema
// of its own, since the stream's own filterable fields are already the source of truth. Scoped to
// the individual user, not just the business — each user's own saved views, matching
// ActivitySavedViewService's businessId+userId scoping.
model ActivitySavedView {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  name       String
  filters    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, userId])
}
