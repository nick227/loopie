# Database (shared by apps/server and apps/ad-server)
DATABASE_URL=mysql://root:password@localhost:3306/loopie_dev

# Server
PORT=3001
SESSION_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173
TRACKING_BASE_URL=http://localhost:3001
AD_SERVER_URL=http://localhost:3002

# Ad Server (apps/ad-server — a separate deployable Railway service)
AD_SERVER_PORT=3002
PRIMARY_APP_URL=http://localhost:3001

# Web
VITE_API_URL=http://localhost:3001
PUBLIC_APP_URL=http://localhost:5173

# Stripe — LOOPIE subscription billing only. Do not wire this to client ad custody.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional. Express connected accounts default to US.
STRIPE_CONNECT_COUNTRY=US
