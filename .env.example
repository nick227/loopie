# Database (shared by apps/server and apps/ad-server)
DATABASE_URL=mysql://root:password@localhost:3306/loopie_dev

# Server
PORT=3001
SESSION_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173
TRACKING_BASE_URL=http://localhost:3001
AD_SERVER_URL=http://localhost:3002

# Ad Server (apps/ad-server — a separate deployable Railway service)
AD_SERVER_PORT=3002
PRIMARY_APP_URL=http://localhost:3001

# Web
VITE_API_URL=http://localhost:3001
PUBLIC_APP_URL=http://localhost:5173

# Media storage — local disk is always the durable copy.
# Dev defaults to ./uploads (relative to the server process cwd).
# Railway: attach a volume to apps/server, mount it at /data/uploads, and set
# UPLOAD_DIR=/data/uploads or every deploy wipes files.
UPLOAD_DIR=
# R2 overlay is production-only. When all of these are set and NODE_ENV=production,
# uploads also PutObject to the bucket and GET /uploads/:key 302s to R2_PUBLIC_URL.
# If R2 is down, the local copy is served. Localhost never talks to R2.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Advertiser connectors — Meta is the first registered adapter.
# Unset → connect/push 503. Redirect URI must match the Meta app exactly:
# {TRACKING_BASE_URL}/platforms/META/oauth/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# 32+ char secret for AES-GCM token seal. Falls back to a hash of SESSION_SECRET.
PLATFORM_TOKEN_KEY=

# CRM connectors — unset → OAuth 503; stub POST /integrations still works in tests.
# Redirects: {TRACKING_BASE_URL}/integrations/HUBSPOT/oauth/callback
#            {TRACKING_BASE_URL}/integrations/SHOPIFY/oauth/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=

# Stripe — LOOPIE subscription billing only. Do not wire this to client ad custody.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional. Express connected accounts default to US.
STRIPE_CONNECT_COUNTRY=US
